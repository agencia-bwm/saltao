{
  "kind": "collectionType",
  "collectionName": "artigos",
  "info": {
    "singularName": "artigo",
    "pluralName": "artigos",
    "displayName": "Artigo do Guia",
    "description": "Guia da Serra do Itaqueri."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 110,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria-guia.categoria-guia",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::autor.autor",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "dataPublicacao": {
      "type": "date",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "dataAtualizacao": {
      "type": "date",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "resumo": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "imagemDestaque": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-alt",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "corpo": {
      "type": "dynamiczone",
      "components": [
        "blocks.texto",
        "blocks.imagem",
        "blocks.tabela",
        "blocks.citacao",
        "blocks.cta-produto"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "fontes": {
      "type": "component",
      "repeatable": true,
      "component": "shared.source-link",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ctaProduto": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::produto.produto",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "artigosRelacionados": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::artigo.artigo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}