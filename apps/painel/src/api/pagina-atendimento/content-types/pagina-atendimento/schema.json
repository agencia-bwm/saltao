{
  "kind": "collectionType",
  "collectionName": "paginas_atendimento",
  "info": {
    "singularName": "pagina-atendimento",
    "pluralName": "paginas-atendimento",
    "displayName": "Página FAQ / Contato",
    "description": "Dúvidas e Contato, Minha reserva."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 90,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "respostaDireta": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "faq_contato",
        "minha_reserva"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "grupos": {
      "type": "component",
      "repeatable": true,
      "component": "shared.grupo-faq",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "mostrarFormulario": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "textoConsentimento": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}