{
  "kind": "collectionType",
  "collectionName": "paginas_atendimento",
  "info": {
    "singularName": "pagina-atendimento",
    "pluralName": "paginas-atendimento",
    "displayName": "Página FAQ / Contato",
    "description": "Dúvidas e Contato, Minha reserva, ou a central de Atendimento (landing)."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 90,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "respostaDireta": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "faq_contato",
        "minha_reserva",
        "central"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "grupos": {
      "type": "component",
      "repeatable": true,
      "component": "shared.grupo-faq",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "mostrarFormulario": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "textoConsentimento": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "sobretitulo": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tituloDestaque": {
      "type": "string",
      "maxLength": 60,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "fotosIntro": {
      "type": "component",
      "repeatable": true,
      "component": "shared.image-alt",
      "max": 2,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "secoes": {
      "type": "dynamiczone",
      "components": [
        "blocks.setor",
        "blocks.experiencias",
        "blocks.galeria",
        "blocks.chamada",
        "blocks.avaliacoes",
        "blocks.texto",
        "blocks.imagem",
        "blocks.tabela",
        "blocks.fatos",
        "blocks.faq",
        "blocks.mapa-estatico",
        "blocks.video",
        "blocks.cta-produto"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}