{
  "kind": "collectionType",
  "collectionName": "avaliacoes",
  "info": {
    "singularName": "avaliacao",
    "pluralName": "avaliacoes",
    "displayName": "Avaliação",
    "description": "Só avaliações reais, com fonte. Exibidas no HTML; sem aggregateRating no schema global."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "nomeAutor": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "nota": {
      "type": "integer",
      "required": true,
      "min": 1,
      "max": 5
    },
    "texto": {
      "type": "text",
      "required": true,
      "maxLength": 1000
    },
    "data": {
      "type": "date",
      "required": true
    },
    "fonte": {
      "type": "enumeration",
      "enum": [
        "Google",
        "TripAdvisor",
        "Booking",
        "Pos_visita"
      ],
      "required": true
    },
    "urlFonte": {
      "type": "string",
      "maxLength": 500
    },
    "produto": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::produto.produto"
    }
  }
}