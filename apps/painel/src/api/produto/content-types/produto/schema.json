{
  "kind": "collectionType",
  "collectionName": "produtos",
  "info": {
    "singularName": "produto",
    "pluralName": "produtos",
    "displayName": "Produto / pacote",
    "description": "Template Produto/pacote: ingresso, acomodação, espaço, combo ou campanha."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 90,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria-produto.categoria-produto",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "respostaRapida": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "galeria": {
      "type": "component",
      "repeatable": true,
      "component": "shared.image-alt",
      "required": true,
      "min": 1,
      "max": 12,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "video": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.video",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "precoAPartirDe": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "unidadePreco": {
      "type": "enumeration",
      "enum": [
        "por_pessoa",
        "por_noite",
        "por_espaco_dia",
        "por_pessoa_noite"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "motorProdutoId": {
      "type": "string",
      "required": true,
      "maxLength": 60,
      "regex": "^[a-z0-9-]+$",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "setorMotorId": {
      "type": "string",
      "maxLength": 60,
      "regex": "^[a-z0-9-]*$",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "inclui": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "naoInclui": {
      "type": "component",
      "repeatable": true,
      "component": "shared.list-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "regras": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "capacidade": {
      "type": "component",
      "repeatable": true,
      "component": "shared.key-value",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tabelaComparativa": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.tabela",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "relacionados": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::produto.produto",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "avaliacoes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::avaliacao.avaliacao",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tipoSchema": {
      "type": "enumeration",
      "enum": [
        "Product",
        "TouristTrip",
        "LodgingBusiness",
        "Campground"
      ],
      "required": true,
      "default": "Product",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}