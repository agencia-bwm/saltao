{
  "kind": "collectionType",
  "collectionName": "categorias_produto",
  "info": {
    "singularName": "categoria-produto",
    "pluralName": "categorias-produto",
    "displayName": "Listagem de produtos",
    "description": "Day Use, Hospedagem e Camping, Churrasqueiras e Quiosques, Monte sua Experiência."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true,
      "maxLength": 90,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "respostaDireta": {
      "type": "text",
      "required": true,
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "introducao": {
      "type": "blocks",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "imagemHero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.image-alt",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ordemProdutos": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::produto.produto",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "faq": {
      "type": "component",
      "repeatable": true,
      "component": "shared.faq-item",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "ordemMenu": {
      "type": "integer",
      "default": 10,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}