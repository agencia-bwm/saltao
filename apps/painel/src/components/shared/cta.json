{
  "collectionName": "components_shared_cta",
  "info": {
    "displayName": "Chamada (CTA)",
    "icon": "cursor"
  },
  "options": {},
  "attributes": {
    "rotulo": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "produto",
        "categoria",
        "pagina",
        "link",
        "whatsapp"
      ],
      "required": true,
      "default": "link"
    },
    "produto": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::produto.produto"
    },
    "categoria": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::categoria-produto.categoria-produto"
    },
    "pagina": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::pagina-institucional.pagina-institucional"
    },
    "url": {
      "type": "string",
      "maxLength": 500
    }
  }
}