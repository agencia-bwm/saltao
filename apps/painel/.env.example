# ---- Servidor ----
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://painel.saltao.com.br
IS_PROXIED=true
NODE_ENV=production

# ---- Segredos (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))") ----
APP_KEYS="trocar1,trocar2,trocar3,trocar4"
API_TOKEN_SALT=trocar
ADMIN_JWT_SECRET=trocar
TRANSFER_TOKEN_SALT=trocar
JWT_SECRET=trocar
ENCRYPTION_KEY=trocar

# ---- Banco (Hostinger MySQL). Local: DATABASE_CLIENT=sqlite ----
DATABASE_CLIENT=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=u000000000_painel
DATABASE_USERNAME=u000000000_painel
DATABASE_PASSWORD=trocar
DATABASE_POOL_MAX=5

# ---- Segurança ----
CORS_ORIGINS=https://www.saltao.com.br,https://painel.saltao.com.br
UPLOAD_MAX_BYTES=15728640

# ---- Rebuild do site ao publicar (decisão 1) ----
GITHUB_REPO=agencia-bwm/saltao
GITHUB_DISPATCH_TOKEN=
REBUILD_DEBOUNCE_MS=60000
