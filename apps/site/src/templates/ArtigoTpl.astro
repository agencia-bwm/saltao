---
/** Template "Artigo" do Guia: resumo direto no topo, autoria e datas visíveis (E-E-A-T), fontes, FAQ e CTA de produto. */
import { getImage } from "astro:assets";
import type { Rota, Indice } from "../lib/routes";
import type { Artigo } from "../lib/types";
import { absoluta } from "../lib/config";
import { noArtigo, noFaq, noWebPage } from "../lib/schema";
import { formatData, t } from "../lib/i18n";
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import Blocos from "../components/Blocos.astro";
import FaqLista from "../components/FaqLista.astro";

interface Props {
  rota: Extract<Rota, { kind: "artigo" }>;
  indice: Indice;
}
const { rota, indice } = Astro.props;
const { doc: a, autor, categoria, locale } = rota;
const ui = t(locale);
const abs = (s: string) => (s.startsWith("http") ? s : absoluta(s));
const imgSchema = abs((await getImage({ src: a.imagemDestaque.src, width: 1200, height: 675, fit: "cover", format: "jpg", quality: 75 })).src);
const fotoAutor = autor ? abs((await getImage({ src: autor.foto.src, width: 192, height: 192, fit: "cover", format: "jpg" })).src) : undefined;

// Relacionados: os escolhidos no painel; se vazio, os mais recentes da mesma categoria.
let relacionados = a.relacionadosIds.map((id) => indice.artigo(id, locale)).filter((x): x is Artigo => !!x);
if (!relacionados.length) relacionados = indice.conteudo.artigos.filter((x) => x.locale === locale && x.documentId !== a.documentId && x.categoriaId === a.categoriaId).slice(0, 3);
const corpo = a.ctaProdutoId && !a.corpo.some((b) => b.__component === "blocks.cta-produto") ? [...a.corpo, { __component: "blocks.cta-produto" as const, produtoId: a.ctaProdutoId }] : a.corpo;
---

<Base {...rota} indice={indice} imagem={a.imagemDestaque} ogTipo="article" topoSobreposto jsonld={[noWebPage(rota.path, a.titulo, a.resumo, locale), noArtigo(a, autor, rota.path, imgSchema, fotoAutor), noFaq(a.faq, rota.path)].filter((n) => n !== null)}>
  <header slot="topo" class="topo-artigo">
    {categoria && <p class="eyebrow">{categoria.nome}</p>}
    <h1>{a.titulo}</h1>
    <p class="lead resumo">{a.resumo}</p>
    <p class="meta">
      {autor && <>{ui.por} <strong>{autor.nome}</strong> · </>}
      {ui.publicadoEm} <time datetime={a.dataPublicacao}>{formatData(a.dataPublicacao, locale)}</time> ·
      {ui.atualizadoEm} <time datetime={a.dataAtualizacao}>{formatData(a.dataAtualizacao, locale)}</time>
    </p>
  </header>
  <article class="section">
    <div class="container capa">
      <Foto class="sobe" img={a.imagemDestaque} prioridade sizes="(min-width: 60rem) 60rem, 100vw" proporcao={16 / 9} larguras={[640, 960, 1280]} />
    </div>

    <div class="container-narrow corpo">
      <Blocos blocos={corpo} indice={indice} locale={locale} estreito />
      <FaqLista itens={a.faq} titulo={ui.faq} id="faq" />

      {
        a.fontes.length > 0 && (
          <section class="fontes">
            <h2>{ui.fontes}</h2>
            <ol>
              {a.fontes.map((f) => (
                <li>
                  <a href={f.url} rel="noopener" target="_blank">
                    {f.titulo}
                  </a>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      {
        autor && (
          <aside class="autor">
            <Foto img={autor.foto} sizes="96px" larguras={[96, 192]} proporcao={1} />
            <div>
              <p>
                <strong>{autor.nome}</strong>
              </p>
              <p>{autor.minibio}</p>
              {autor.link && <a href={autor.link}>{autor.link.replace(/^https?:\/\//, "")}</a>}
            </div>
          </aside>
        )
      }
    </div>

    {
      relacionados.length > 0 && (
        <nav class="container relacionados" aria-labelledby="rel-titulo">
          <h2 id="rel-titulo">{ui.leiaTambem}</h2>
          <ul>
            {relacionados.map((r) => (
              <li>
                <a href={indice.link("artigo", r.documentId, locale)}>{r.titulo}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .topo-artigo {
    max-width: 50rem;
  }
  .capa {
    max-width: 60rem;
    margin-block: 0 var(--space-6);
  }
  .capa :global(img) {
    width: 100%;
    border-radius: var(--radius-lg) var(--radius-arco) var(--radius-lg) var(--radius-lg);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .corpo {
    font-size: var(--fs-300);
  }
  .fontes {
    font-size: var(--fs-100);
  }
  .autor {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    margin-top: var(--space-7);
    padding: var(--space-5);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-lg);
    font-size: var(--fs-100);
  }
  .autor :global(img) {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
  }
  .autor p {
    margin-bottom: var(--space-2);
  }
  .relacionados ul {
    padding-left: var(--space-5);
  }
</style>
