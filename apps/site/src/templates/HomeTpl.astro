---
import type { Rota, Indice } from "../lib/routes";
import { noFaq, noWebPage } from "../lib/schema";
import { linkReserva } from "../lib/config";
import { formatPreco, t } from "../lib/i18n";
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import Icone from "../components/Icone.astro";
import Secoes from "../components/Secoes.astro";
import cssAbaixo from "../styles/home-abaixo.css?url";

interface Props {
  rota: Extract<Rota, { kind: "home" }>;
  indice: Indice;
}
const { rota, indice } = Astro.props;
const { doc, locale } = rota;
const ui = t(locale);
const hero = doc.hero;
const faqs = doc.secoes.flatMap((b) => (b.__component === "blocks.faq" ? b.itens : []));
const ctaHref = hero.cta?.tipo === "produto" && hero.cta.produtoId ? indice.link("produto", hero.cta.produtoId, locale) : (hero.cta?.url ?? linkReserva({ lang: locale }));

// Card flutuante: um produto do painel, com foto, categoria e preço "a partir de".
const LARGURAS_HERO = [480, 760, 1080, 1440, 1600];
const cardProd = hero.cardProdutoId ? indice.produto(hero.cardProdutoId, locale) : undefined;
const cardHref = hero.cardProdutoId ? indice.link("produto", hero.cardProdutoId, locale) : undefined;
const cardCat = cardProd ? indice.categoriaProduto(cardProd.categoriaId, locale) : undefined;
---

<Base {...rota} indice={indice} imagem={hero.imagem} preload={{ img: hero.imagem, larguras: LARGURAS_HERO, sizes: "100vw" }} jsonld={[noWebPage(rota.path, doc.seo.metaTitle, hero.respostaDireta, locale), noFaq(faqs, rota.path)].filter((n) => n !== null)}>
  <section class="hero-wrap">
    <div class="hero">
      <Foto img={hero.imagem} prioridade sizes="100vw" class="hero-img" larguras={LARGURAS_HERO} />
      <div class="hero-veu">
        <div class="container hero-conteudo">
          {hero.sobretitulo && <p class="hero-sobre">{hero.sobretitulo}</p>}
          <h1>
            {hero.titulo}
            {hero.tituloDestaque && <span class="destaque">{hero.tituloDestaque}</span>}
          </h1>
          <p class="resposta">{hero.respostaDireta}</p>
          <a class="btn btn-claro" href={ctaHref} data-dl='{"event":"click_reservar","method":"hero"}'>
            <Icone nome="calendario" tamanho={20} />
            {hero.cta?.rotulo ?? ui.reservar}
            <Icone nome="seta" tamanho={18} class="seta" />
          </a>
          {
            hero.selo && (
              <p class="selo">
                <svg viewBox="166 62 118 166" width="18" height="26" aria-hidden="true" focusable="false">
                  <path fill="#489ed2" d="M239.58 73.19c-4.78-2.11-9.34-3.38-13.55-3.55-48.59-1.9-53.53 26.05-53.53 90.66 0 19.02 2.39 40.3 6.97 60.88-1.26-15.83-1.66-32.09-1.66-47.49 0-62.75 16.3-98.48 61.77-100.5Z" />
                  <path fill="#ffffff" d="M258.58 73.19c-4.79-2.11-9.34-3.38-13.55-3.55-48.61-1.9-53.54 26.05-53.54 90.66 0 19.02 2.4 40.3 6.98 60.88-1.26-15.83-1.67-32.09-1.67-47.49 0-62.75 16.31-98.48 61.78-100.5Z" />
                  <path fill="#a0c9e8" d="M278.53 73.33c-4.78-2.11-9.34-3.38-13.55-3.55-48.6-1.9-53.53 26.05-53.53 90.66 0 19.02 2.38 40.31 6.97 60.88-1.25-15.82-1.66-32.09-1.66-47.5 0-62.73 16.31-98.47 61.77-100.49Z" />
                </svg>
                {hero.selo}
              </p>
            )
          }
        </div>
      </div>
      <!-- Borda de baixo em curva, com a "água" azul-clara saindo pela direita. -->
      <svg class="onda" viewBox="0 0 1440 220" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path class="onda-agua" d="M0 220V170c260 40 560 52 860 4 260-42 430-128 580-174v390Z" />
        <path class="onda-fundo" d="M0 220V196c300 30 620 30 900-14 250-40 400-96 540-128v166Z" />
      </svg>
    </div>

    {
      cardProd && cardHref && (
        <aside class="card-flutuante" aria-label={hero.cardRotulo ?? cardProd.titulo}>
          {hero.cardRotulo && (
            <p class="card-rotulo">
              <svg viewBox="0 0 64 24" width="44" height="17" aria-hidden="true" focusable="false">
                <path d="M2 20c14-2 30-8 42-16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="3 4" />
                <path d="M40 2.5 46 3l-2.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {hero.cardRotulo}
            </p>
          )}
          <div class="card-caixa">
            <div class="card-foto">
              {cardProd.galeria[0] && <Foto img={cardProd.galeria[0]} sizes="20rem" larguras={[320, 640]} proporcao={16 / 9} />}
              {cardCat && (
                <span class="pino">
                  <Icone nome="pin" tamanho={14} />
                  {cardCat.titulo}
                </span>
              )}
              <span class="seta-circulo seta-circulo-claro" aria-hidden="true">
                <Icone nome="seta" tamanho={16} />
              </span>
            </div>
            <div class="card-corpo">
              <h2 class="card-titulo">
                <a href={cardHref}>{cardProd.titulo}</a>
              </h2>
              <p class="card-texto">{cardProd.respostaRapida}</p>
              <p class="card-preco">
                <Icone nome="calendario" tamanho={15} />
                {ui.aPartirDe} {formatPreco(cardProd.precoAPartirDe, locale)} {ui.unidade[cardProd.unidadePreco]}
              </p>
            </div>
          </div>
        </aside>
      )
    }
  </section>

  <!-- CSS das seções abaixo da dobra: no corpo, não bloqueia o desenho do hero. -->
  <link rel="stylesheet" href={cssAbaixo} />
  <div class="container secoes">
    <Secoes blocos={doc.secoes} indice={indice} locale={locale} />
  </div>
</Base>

<style>
  /* Hero na largura total da tela. */
  .hero-wrap {
    position: relative;
    width: 100%;
    /* Sobe por trás do cabeçalho (4,5rem): a foto aparece dos lados da barra do menu. */
    margin-top: -4.5rem;
  }
  .hero {
    position: relative;
    display: grid;
    min-height: min(92svh, 50rem);
    color: #ffffff;
    background: var(--brand-poco);
    overflow: hidden;
  }
  .hero > :global(picture),
  .hero-veu {
    grid-area: 1 / 1;
  }
  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Véu no azul do poço (não preto), mais forte à esquerda, onde fica o texto. */
  .hero-veu {
    display: flex;
    align-items: center;
    padding-block: calc(4.5rem + var(--space-8)) clamp(var(--space-9), 14vw, 12rem);
    background:
      linear-gradient(to right, rgb(15 39 68 / 0.78) 0%, rgb(15 39 68 / 0.5) 38%, rgb(15 39 68 / 0) 68%),
      linear-gradient(to top, rgb(15 39 68 / 0.55) 0%, rgb(15 39 68 / 0) 45%);
  }
  .hero-conteudo {
    width: min(100% - 2 * var(--space-5), 84rem);
  }
  .hero-sobre {
    margin-bottom: var(--space-4);
    font-size: var(--fs-100);
    font-weight: var(--fw-medio);
    letter-spacing: 0.04em;
    color: var(--color-on-deep);
  }
  .hero h1 {
    font-family: var(--font-sans);
    max-width: 14ch;
    margin-bottom: var(--space-5);
    color: #ffffff;
    font-size: clamp(2.5rem, 1.5rem + 4vw, 4.75rem);
    font-weight: var(--fw-medio);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-shadow: 0 2px 24px rgb(15 39 68 / 0.35);
  }
  .destaque {
    display: block;
    color: var(--brand-azul-claro);
  }
  .resposta {
    max-width: 42ch;
    margin-bottom: var(--space-6);
    color: var(--color-on-deep);
    text-wrap: pretty;
  }
  .hero .btn-claro {
    min-height: 54px;
    padding-inline: var(--space-6);
  }
  .selo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    max-width: 34ch;
    margin: var(--space-6) 0 0;
    font-size: var(--fs-100);
    line-height: 1.35;
    color: var(--color-on-deep);
  }
  .selo svg {
    flex-shrink: 0;
  }

  /* Onda: cobre o pé da foto com o fundo da página; a faixa clara é a água. */
  .onda {
    position: absolute;
    inset: auto 0 -1px;
    width: 100%;
    height: clamp(3.5rem, 13vw, 12rem);
    pointer-events: none;
  }
  .onda-agua {
    fill: var(--brand-ceu);
  }
  .onda-fundo {
    fill: var(--color-bg);
  }

  /* Card flutuante: no celular, logo abaixo da foto; no desktop, sobre a foto, à direita. */
  .card-flutuante {
    position: relative;
    z-index: 2;
    width: min(100% - 2 * var(--space-3), 22rem);
    margin: calc(-1 * var(--space-7)) auto 0;
  }
  .card-rotulo {
    display: none;
  }
  .card-caixa {
    position: relative;
    padding: var(--space-2);
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 48px -20px rgb(15 39 68 / 0.45);
  }
  .card-foto {
    position: relative;
  }
  .card-foto :global(img) {
    width: 100%;
    border-radius: calc(var(--radius-lg) - 6px) calc(var(--radius-lg) - 6px) var(--radius-sm) var(--radius-sm);
  }
  .pino {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 0.2rem var(--space-3) 0.2rem var(--space-2);
    border-radius: var(--radius-pill);
    background: rgb(15 39 68 / 0.62);
    color: #ffffff;
    font-size: 0.8125rem;
    font-weight: var(--fw-medio);
  }
  .card-foto .seta-circulo {
    position: absolute;
    right: var(--space-3);
    bottom: calc(-1 * var(--space-4));
  }
  .card-corpo {
    padding: var(--space-4) var(--space-3) var(--space-2);
  }
  .card-titulo {
    margin: 0 0 var(--space-1);
    font-family: var(--font-sans);
    font-size: var(--fs-200);
    font-weight: var(--fw-forte);
    letter-spacing: -0.01em;
  }
  .card-titulo a {
    color: var(--brand-poco);
    text-decoration: none;
  }
  /* O card todo é clicável (link esticado), sem aninhar links. */
  .card-titulo a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
  }
  .card-titulo a:focus-visible {
    outline: none;
  }
  .card-titulo a:focus-visible::after {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .card-texto {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-bottom: var(--space-2);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }
  .card-preco {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: 0.875rem;
    font-weight: var(--fw-medio);
    color: var(--color-primary-strong);
  }

  @media (min-width: 64rem) {
    .card-flutuante {
      position: absolute;
      top: calc(4.5rem + clamp(var(--space-7), 9vw, 7.5rem));
      /* Alinhado à borda direita do conteúdo (84rem), não da tela. */
      right: max(var(--space-5), calc((100% - 84rem) / 2));
      width: 21rem;
      margin: 0;
      transform: rotate(1.5deg);
    }
    .card-rotulo {
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      gap: var(--space-2);
      margin: 0 var(--space-3) var(--space-2) 0;
      color: #ffffff;
      font-size: var(--fs-100);
      font-weight: var(--fw-medio);
      text-shadow: 0 1px 12px rgb(15 39 68 / 0.6);
    }
  }
  @media (max-width: 40rem) {
    .hero {
      min-height: 88svh;
    }
    .hero-veu {
      align-items: flex-end;
      background: linear-gradient(to top, rgb(15 39 68 / 0.92) 0%, rgb(15 39 68 / 0.55) 50%, rgb(15 39 68 / 0.1) 80%);
    }
  }

  .secoes {
    padding-top: var(--space-6);
  }
  /* Títulos de seção da home no peso médio do layout novo (reserva de fonte medida para texto). */
  .secoes :global(h2) {
    font-family: var(--font-sans);
    font-weight: var(--fw-medio);
  }
</style>
