---
/**
 * Template Home — linha editorial guiada pelas fotos: hero em tela cheia com o menu por cima e as seções do painel
 * em faixas de largura total. Os capítulos (Cachoeiras, Day Use, Apartamentos, Camping) são o corpo da página;
 * reservar é com o motor — aqui não há formulário nem grade de preços.
 */
import type { Rota, Indice } from "../lib/routes";
import { noFaq, noWebPage } from "../lib/schema";
import { hrefCta } from "../lib/cta";
import { t } from "../lib/i18n";
import { enfase } from "../lib/texto";
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import Blocos from "../components/Blocos.astro";

interface Props {
  rota: Extract<Rota, { kind: "home" }>;
  indice: Indice;
}
const { rota, indice } = Astro.props;
const { doc, locale } = rota;
const ui = t(locale);
const hero = doc.hero;
const faqs = doc.secoes.flatMap((b) => (b.__component === "blocks.faq" ? b.itens : []));
const ctaHref = hrefCta(hero.cta, indice, locale);

// O 2º botão do hero desce até o primeiro capítulo com âncora; a barra de atalhos lista todos.
const capitulos = doc.secoes.flatMap((b) => (b.__component === "blocks.capitulo" && b.ancora ? [{ ancora: b.ancora, rotulo: b.sobretitulo ?? b.titulo }] : []));
const ancoraDescubra = capitulos[0]?.ancora;
// Nome grande do hero: a marca, como no logo (ex.: "Saltão").
const g = indice.conteudo.global[locale] ?? indice.conteudo.global.pt;
const marca = (g?.nomeOficial ?? "Saltão").split(/\s+[—–-]\s+/)[0];
---

<Base {...rota} indice={indice} imagem={hero.imagem} jsonld={[noWebPage(rota.path, doc.seo.metaTitle, hero.respostaDireta, locale), noFaq(faqs, rota.path)].filter((n) => n !== null)}>
  <section class="hero no-escuro">
    <Foto img={hero.imagem} prioridade sizes="100vw" class="hero-img" larguras={[480, 760, 1080, 1440, 1600]} />
    <div class="hero-texto">
      <div class="hero-centro">
        {hero.sobretitulo && <p class="hero-sobre">{hero.sobretitulo}</p>}
        <p class="hero-marca" aria-hidden="true">{marca}</p>
        <h1 set:html={enfase(hero.titulo)} />
        <p class="resposta">{hero.respostaDireta}</p>
        <div class="acoes">
          <a class="btn btn-claro" href={ctaHref} data-dl='{"event":"click_reservar","method":"hero"}'>{hero.cta?.rotulo ?? ui.reservar}</a>
        </div>
      </div>
      {
        ancoraDescubra && (
          <a class="hero-descer" href={`#${ancoraDescubra}`}>
            <span>{ui.descubra}</span>
          </a>
        )
      }
    </div>
  </section>
  <div class="container secoes">
    <Blocos blocos={doc.secoes} indice={indice} locale={locale} home />
  </div>
</Base>

<style>
  /* ---------- Hero (resort editorial: tudo centralizado sobre a foto) ---------- */
  .hero {
    position: relative;
    display: grid;
    min-height: min(100svh, 60rem);
    color: #ffffff;
    background: var(--brand-poco);
    overflow: hidden;
  }
  .hero > :global(picture) {
    position: absolute;
    inset: 0;
  }
  .hero :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 55%;
  }
  /* Sombra preta leve no centro (onde está o texto) e no pé. A foto aparece. */
  .hero-texto {
    position: relative;
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    padding: calc(var(--altura-cabecalho) + var(--space-6)) var(--space-4) var(--space-9);
    background:
      radial-gradient(52rem 30rem at 50% 50%, rgb(0 0 0 / 0.32), rgb(0 0 0 / 0) 70%),
      linear-gradient(to top, rgb(0 0 0 / 0.4) 0%, rgb(0 0 0 / 0) 30%);
  }
  .hero-centro {
    display: grid;
    justify-items: center;
    text-align: center;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.45);
  }
  .hero-sobre {
    margin: 0 0 var(--space-5);
    font-size: var(--fs-100);
    font-weight: var(--fw-medio);
    letter-spacing: clamp(0.1em, 0.02em + 0.6vw, 0.32em);
    /* Uma linha só: a quebra não pode depender da largura da fonte (CLS zero). */
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    color: #ffffff;
  }
  .hero-marca {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display-leve);
    font-size: clamp(3.5rem, 1rem + 12vw, 12rem);
    font-weight: 100;
    line-height: 0.85;
    letter-spacing: 0.14em;
    margin-right: -0.14em; /* compensa o espaçamento da última letra para centralizar de verdade */
    text-transform: uppercase;
    white-space: nowrap;
    color: #ffffff;
  }
  .hero h1 {
    max-width: 40ch;
    margin: 0 0 var(--space-4);
    color: #ffffff;
    font-size: clamp(1.15rem, 0.9rem + 1vw, 1.6rem);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hero h1 :global(em) {
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    color: var(--brand-azul-claro);
    font-weight: 400;
  }
  .resposta {
    max-width: 46ch;
    margin: 0 0 var(--space-6);
    font-size: var(--fs-200);
    color: rgb(255 255 255 / 0.92);
    text-wrap: pretty;
  }
  .acoes .btn {
    min-height: 52px;
    padding-inline: var(--space-7);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: var(--fs-100);
  }
  /* Convite para descer: fio fino vertical + texto pequeno. */
  .hero-descer {
    position: absolute;
    left: 50%;
    bottom: var(--space-5);
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    min-height: 44px;
    font-size: var(--fs-100);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #ffffff;
    text-decoration: none;
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.5);
  }
  .hero-descer::after {
    content: "";
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, #ffffff, rgb(255 255 255 / 0));
  }
  .hero-descer:hover {
    color: #ffffff;
  }

  /* ---------- Seções em faixas de largura total ---------- */
  .secoes > :global(section) {
    margin: 0 calc(50% - 50vw);
    padding: clamp(var(--space-8), 9vw, var(--space-9)) calc(50vw - 50%);
  }
  /* Títulos de seção: grandes e leves. */
  .secoes > :global(section > h2) {
    max-width: 20ch;
    margin: 0 0 var(--space-7);
    font-size: clamp(2.1rem, 1.3rem + 3vw, 3.75rem);
    font-weight: 250;
  }
  /* Capítulos: cuidam do próprio espaço (foto até a borda). */
  .secoes > :global(.capitulo) {
    padding: 0;
  }

  /* Experiências: trilho com scroll-snap no celular; grade "bento" no computador
     (1º card grande 2×2, 2º largo 2×1, os demais 1×1). */
  .secoes :global(.trilho-cards) {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-3);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 21rem);
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .secoes :global(.trilho-cards > li) {
    scroll-snap-align: start;
  }
  @media (min-width: 60rem) {
    .secoes :global(.trilho-cards) {
      grid-auto-flow: row dense;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: minmax(16rem, 19rem);
      gap: var(--space-4);
      overflow: visible;
      padding-bottom: 0;
    }
    .secoes :global(.trilho-cards > li:first-child) {
      grid-column: span 2;
      grid-row: span 2;
    }
    .secoes :global(.trilho-cards > li:nth-child(2)),
    .secoes :global(.trilho-cards > li:last-child:nth-child(3)) {
      grid-column: span 2;
    }
    .secoes :global(.trilho-cards .card-foto) {
      min-height: 0;
    }
  }

  /* Roteiro: faixa do poço. */
  .secoes > :global(.roteiro) {
    background: var(--grad-faixa-topo);
    border-radius: 0 var(--radius-arco) 0 var(--radius-faixa);
  }

  /* Frase: grande, centralizada, sobre o céu. */
  .secoes > :global(.frase) {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .secoes :global(.frase-arcos) {
    width: 3.5rem;
    height: auto;
    margin-bottom: var(--space-6);
  }
  .secoes :global(.frase blockquote) {
    margin: 0;
  }
  .secoes :global(.frase p) {
    max-width: 22ch;
    margin: 0 auto;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 4rem);
    font-weight: 250;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--brand-poco);
    text-wrap: balance;
  }
  .secoes :global(.frase cite) {
    display: block;
    margin-top: var(--space-5);
    font-style: normal;
    color: var(--color-text-muted);
  }

  /* Panorâmica: foto de ponta a ponta, alta, com a legenda sobre o pé da imagem. */
  .secoes > :global(.panoramica) {
    padding: 0;
  }
  .secoes :global(.panoramica figure) {
    position: relative;
    margin: 0;
  }
  .secoes :global(.panoramica img) {
    width: 100%;
    height: clamp(22rem, 62vw, 50rem);
    object-fit: cover;
    object-position: 50% 60%;
    border-radius: var(--radius-arco) 0 var(--radius-arco) 0;
  }
  .secoes :global(.panoramica figcaption) {
    position: absolute;
    left: max(var(--space-4), calc(50vw - var(--container) / 2));
    bottom: var(--space-5);
    padding: var(--space-2) var(--space-4);
    font-size: var(--fs-100);
    font-weight: var(--fw-medio);
    color: #ffffff;
    background: rgb(15 39 68 / 0.6);
    border-radius: var(--radius-pill);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  /* Números logo depois da foto: sem a curva no topo, colado na imagem. */
  .secoes > :global(.panoramica + .fatos) {
    margin-top: var(--space-6);
  }

  /* Poema de abertura (citação sem foto): linhas curtas, centralizadas, em caixa-alta fina. */
  .secoes > :global(.frase:not(.frase--foto)) {
    padding-block: clamp(5rem, 10vw, 8rem) var(--space-6);
  }
  .secoes > :global(.frase:not(.frase--foto) .frase-arcos) {
    width: 2.5rem;
  }
  .secoes :global(.frase:not(.frase--foto) p) {
    max-width: none;
    font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.6rem);
    font-weight: 300;
    line-height: 1.9;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-poco);
  }
  .secoes :global(.frase:not(.frase--foto) em) {
    background: none;
    -webkit-background-clip: border-box;
    background-clip: border-box;
    color: var(--color-primary-strong);
  }
  .secoes > :global(.indice) {
    margin-inline: auto;
    padding-inline: 0;
  }
  .secoes > :global(.narrativa) {
    padding-inline: 0;
  }

  /* Frase sobre foto de ponta a ponta. */
  .secoes > :global(.frase--foto) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(80svh, 44rem);
    align-content: center;
    background: var(--brand-poco);
  }
  .secoes :global(.frase--foto > picture) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .secoes :global(.frase--foto .frase-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .secoes > :global(.frase--foto)::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.18);
  }
  .secoes :global(.frase--foto p) {
    color: #ffffff;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.55);
  }

  /* Números: faixa azul média, de ponta a ponta. */
  .secoes > :global(.fatos) {
    margin-block: 0;
    background: var(--grad-faixa-media);
    border-radius: var(--radius-arco) 0 0 0;
  }
  .secoes > :global(.fatos > h2) {
    color: #ffffff;
  }

  /* Avaliações: cards brancos sobre o céu. */
  .secoes > :global(.avaliacoes figure) {
    background: var(--color-bg);
  }

  /* FAQ em duas colunas: título fixo à esquerda, perguntas à direita. */
  @media (min-width: 60rem) {
    .secoes > :global(.faq) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      column-gap: var(--space-8);
      align-items: start;
    }
    .secoes > :global(.faq > h2) {
      grid-row: 1 / span 20;
      position: sticky;
      top: calc(var(--altura-cabecalho) + var(--space-6));
    }
    .secoes > :global(.faq > details) {
      grid-column: 2;
    }
  }

  /* Chamada final: foto de ponta a ponta, sem padding da faixa. */
  .secoes > :global(.chamada-final) {
    padding: 0;
    margin-top: var(--space-6);
    border-radius: 0 var(--radius-arco) 0 var(--radius-faixa);
  }
</style>
