---
/**
 * Toda imagem do site passa por aqui: AVIF + WebP, srcset, width/height fixos.
 * `prioridade` = imagem LCP (hero): eager + fetchpriority high + qualidade 35 (fotos reais com
 * muita mata pesavam ~220 KB em AVIF a 960 px e estouravam o LCP no mobile; a 35 a perda não é visível). O resto é lazy, qualidade 50 (as fotos dos cards carregam junto com o hero no mobile).
 */
import { Picture } from "astro:assets";
import type { Img } from "../lib/types";
import { medidas, QUALIDADE } from "../lib/foto";

interface Props {
  img: Img;
  sizes?: string;
  prioridade?: boolean;
  larguras?: number[];
  class?: string;
  /** Proporção forçada (ex.: 16/10) — recorta para evitar CLS entre imagens diferentes. */
  proporcao?: number;
  /** Formatos modernos. Abaixo da dobra na home usamos só AVIF (+ JPG de reserva) para o HTML ficar menor. */
  formatos?: ("avif" | "webp")[];
}
const { img, sizes = "100vw", prioridade = false, larguras = [400, 640, 960, 1280, 1600], class: cls, proporcao, formatos = ["avif", "webp"] } = Astro.props;

const { width, height, widths } = medidas(img, larguras, proporcao);
---

<Picture
  src={img.src as ImageMetadata}
  alt={img.alt}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  formats={formatos}
  fallbackFormat="jpg"
  quality={prioridade ? QUALIDADE.prioridade : QUALIDADE.normal}
  fit={proporcao ? "cover" : undefined}
  loading={prioridade ? "eager" : "lazy"}
  decoding={prioridade ? "sync" : "async"}
  fetchpriority={prioridade ? "high" : "auto"}
  class={cls}
  pictureAttributes={{ class: "foto" }}
/>
