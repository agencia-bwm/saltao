---
/**
 * Card de produto.
 * - "padrao": foto em cima, texto e preço embaixo (listagens, relacionados, 404).
 * - "foto": a foto ocupa o card inteiro e o texto fica sobre o véu azul (home, grade bento).
 * Cantos sempre iguais (--radius-card) e recortados com clip-path: o zoom da foto no hover
 * nunca deixa o canto quadrado (bug de overflow + border-radius durante a animação).
 */
import type { CategoriaProduto, Locale, Produto } from "../lib/types";
import { formatPreco, t } from "../lib/i18n";
import { dl, itemGa4 } from "../lib/tracking";
import Foto from "./Foto.astro";

interface Props {
  produto: Produto;
  href: string;
  categoria?: CategoriaProduto;
  locale: Locale;
  lista?: string;
  index?: number;
  nivel?: "h2" | "h3";
  /** Primeiro card de uma listagem: é a imagem LCP da página. */
  prioridade?: boolean;
  variante?: "padrao" | "foto";
  /** Card grande da grade bento: mostra também a resposta rápida. */
  destaque?: boolean;
}
const { produto, href, categoria, locale, lista = "lista", index, nivel = "h3", prioridade = false, variante = "padrao", destaque = false } = Astro.props;
const ui = t(locale);
const H = nivel;
const evento = dl({ event: "select_item", ecommerce: { item_list_name: lista, items: [itemGa4(produto, categoria, index)] } });
---

{
  variante === "foto" ? (
    <article class:list={["card-foto", { "card-foto--destaque": destaque }]}>
      <div class="card-foto-midia">
        {produto.galeria[0] && (
          <Foto img={produto.galeria[0]} sizes={destaque ? "(min-width: 60rem) 36rem, 82vw" : "(min-width: 60rem) 24rem, 82vw"} larguras={destaque ? [480, 720, 960, 1200] : [400, 640, 800]} prioridade={prioridade} />
        )}
      </div>
      <div class="card-foto-texto">
        {categoria && <p class="card-foto-cat">{categoria.titulo}</p>}
        <H class="card-foto-titulo">
          <a href={href} data-dl={evento}>
            {produto.titulo}
          </a>
        </H>
        {destaque && <p class="card-foto-resumo">{produto.respostaRapida}</p>}
        <div class="card-foto-pe">
          <p class="card-foto-preco">
            <span class="de">{ui.aPartirDe}</span>
            <strong>{formatPreco(produto.precoAPartirDe, locale)}</strong> <span>{ui.unidade[produto.unidadePreco]}</span>
          </p>
          <span class="seta" aria-hidden="true">
            <svg viewBox="0 0 20 20" width="18" height="18"><path d="M4 10h11m-4.5-4.5L15 10l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </div>
      </div>
    </article>
  ) : (
    <article class="card">
      <div class="card-midia">
        {produto.galeria[0] && <Foto img={produto.galeria[0]} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, calc(100vw - 2rem)" larguras={[400, 680, 800]} proporcao={16 / 10} prioridade={prioridade} />}
      </div>
      <div class="card-corpo">
        <H class="card-titulo">
          <a href={href} data-dl={evento}>
            {produto.titulo}
          </a>
        </H>
        <p class="card-texto">{produto.respostaRapida}</p>
        <p class="card-preco">
          <span>{ui.aPartirDe}</span>
          <strong>{formatPreco(produto.precoAPartirDe, locale)}</strong>
          <span>{ui.unidade[produto.unidadePreco]}</span>
        </p>
      </div>
    </article>
  )
}

<style>
  /* ---------- Comum ---------- */
  .card,
  .card-foto {
    position: relative;
    height: 100%;
    border-radius: var(--radius-card);
    /* Recorte à prova de animação: o canto não "quadra" durante o zoom da foto. */
    clip-path: inset(0 round var(--radius-card));
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease;
  }
  .card :global(img),
  .card-foto :global(img) {
    width: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover,
  .card-foto:hover {
    transform: translateY(-6px);
  }
  .card:hover :global(img),
  .card-foto:hover :global(img) {
    transform: scale(1.03);
  }
  /* Card inteiro clicável, mantendo um único link acessível. */
  .card-titulo a::after,
  .card-foto-titulo a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .card-titulo a:focus-visible,
  .card-foto-titulo a:focus-visible {
    outline: none;
  }
  /* clip-path cortaria o contorno de foco: o foco vai para dentro do card. */
  .card:focus-within,
  .card-foto:focus-within {
    box-shadow: inset 0 0 0 3px var(--color-focus);
  }

  /* ---------- Padrão ---------- */
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .card-midia {
    overflow: hidden;
  }
  .card :global(img) {
    aspect-ratio: 16 / 10;
  }
  .card-corpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5) var(--space-5) var(--space-4);
  }
  .card-titulo {
    font-size: var(--fs-400);
    font-weight: var(--fw-medio);
    margin: 0 0 var(--space-2);
  }
  .card-titulo a {
    color: var(--brand-poco);
    text-decoration: none;
  }
  .card:hover .card-titulo a {
    color: var(--color-primary-strong);
  }
  .card-texto {
    color: var(--color-text-muted);
    font-size: var(--fs-100);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-preco {
    margin: auto 0 0;
    padding-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
  }
  .card-preco span {
    white-space: nowrap;
  }
  .card-preco strong {
    font-size: var(--fs-400);
    color: var(--color-primary-strong);
  }

  /* ---------- Foto (home) ---------- */
  .card-foto {
    display: flex;
    min-height: 26rem;
    color: #ffffff;
    background: var(--brand-poco);
    isolation: isolate;
  }
  .card-foto-midia {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .card-foto-midia > :global(picture),
  .card-foto :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Véu azul só no pé do card: a foto respira em cima. */
  .card-foto::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(15 39 68 / 0.95) 0%, rgb(15 39 68 / 0.75) 38%, rgb(15 39 68 / 0.25) 68%, rgb(15 39 68 / 0) 85%);
    transition: opacity 0.35s ease;
  }
  .card-foto-texto {
    margin-top: auto;
    width: 100%;
    padding: var(--space-5);
  }
  .card-foto-texto {
    text-shadow: 0 1px 12px rgb(15 39 68 / 0.5);
  }
  .card-foto-cat {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-100);
    font-weight: var(--fw-medio);
    color: var(--brand-azul-claro);
  }
  .card-foto-titulo {
    margin: 0;
    font-size: var(--fs-400);
    font-weight: var(--fw-medio);
    color: #ffffff;
  }
  .card-foto-titulo a {
    color: inherit;
    text-decoration: none;
  }
  .card-foto-resumo {
    max-width: 44ch;
    margin: var(--space-3) 0 0;
    font-size: var(--fs-100);
    color: var(--color-on-deep);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-foto-pe {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-linha-clara);
  }
  .card-foto-preco {
    margin: 0;
    font-size: var(--fs-100);
    line-height: 1.3;
    color: var(--color-on-deep);
  }
  .card-foto-preco .de {
    display: block;
    color: var(--color-on-deep-muted);
  }
  .card-foto-preco strong {
    font-size: var(--fs-300);
    color: #ffffff;
  }
  .seta {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.5);
    color: #ffffff;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }
  .card-foto:hover .seta {
    background: #ffffff;
    border-color: #ffffff;
    color: var(--brand-azul-escuro);
    transform: translateX(3px);
  }
  .card-foto--destaque .card-foto-titulo {
    font-size: var(--fs-500);
    font-weight: var(--fw-leve);
    font-family: var(--font-display-leve);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-foto,
    .card :global(img),
    .card-foto :global(img),
    .seta {
      transition: none;
    }
    .card:hover,
    .card-foto:hover,
    .card:hover :global(img),
    .card-foto:hover :global(img),
    .card-foto:hover .seta {
      transform: none;
    }
  }
</style>
