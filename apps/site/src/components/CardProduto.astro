---
import type { CategoriaProduto, Locale, Produto } from "../lib/types";
import { formatPreco, t } from "../lib/i18n";
import { dl, itemGa4 } from "../lib/tracking";
import Foto from "./Foto.astro";

interface Props {
  produto: Produto;
  href: string;
  categoria?: CategoriaProduto;
  locale: Locale;
  lista?: string;
  index?: number;
  nivel?: "h2" | "h3";
  /** Primeiro card de uma listagem: é a imagem LCP da página. */
  prioridade?: boolean;
}
const { produto, href, categoria, locale, lista = "lista", index, nivel = "h3", prioridade = false } = Astro.props;
const ui = t(locale);
const H = nivel;
const evento = dl({ event: "select_item", ecommerce: { item_list_name: lista, items: [itemGa4(produto, categoria, index)] } });
---

<article class="card">
  {produto.galeria[0] && <Foto img={produto.galeria[0]} sizes="(min-width: 72rem) 22rem, (min-width: 40rem) 45vw, 100vw" larguras={[400, 640, 800]} proporcao={16 / 10} prioridade={prioridade} />}
  <div class="card-corpo">
    <H class="card-titulo"><a href={href} data-dl={evento}>{produto.titulo}</a></H>
    <p class="card-texto">{produto.respostaRapida}</p>
    <p class="card-preco">
      <span>{ui.aPartirDe}</span>
      <strong>{formatPreco(produto.precoAPartirDe, locale)}</strong>
      <span>{ui.unidade[produto.unidadePreco]}</span>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-bg);
    border-radius: var(--radius-lg) var(--radius-arco) var(--radius-lg) var(--radius-lg);
    box-shadow: var(--shadow-sm), 0 0 0 1px var(--color-border);
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }
  .card :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .card-corpo {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-5) var(--space-5) var(--space-4);
  }
  .card-titulo {
    font-size: var(--fs-400);
    font-weight: var(--fw-medio);
    margin: 0 0 var(--space-2);
  }
  .card-titulo a {
    color: var(--brand-poco);
    text-decoration: none;
  }
  /* Card inteiro clicável, mantendo um único link acessível */
  .card-titulo a::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .card:hover {
    box-shadow: var(--shadow-md), 0 0 0 1px var(--brand-azul-claro);
  }
  .card:hover .card-titulo a {
    color: var(--color-primary);
  }
  .card:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }
  .card-titulo a:focus-visible {
    outline: none;
  }
  .card-texto {
    color: var(--color-text-muted);
    font-size: var(--fs-100);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-preco {
    margin: auto 0 0;
    padding-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: baseline;
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    background: var(--grad-arcos) left top / 3rem 2px no-repeat;
  }
  .card-preco span {
    white-space: nowrap;
  }
  .card-preco strong {
    font-size: var(--fs-400);
    color: var(--color-primary-strong);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>
