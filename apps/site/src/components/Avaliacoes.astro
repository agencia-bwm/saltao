---
/** Só avaliações reais, sempre com fonte e data visíveis. Sem aggregateRating no schema (decisão 7). */
import type { Avaliacao, Locale } from "../lib/types";
import { formatData, t } from "../lib/i18n";
interface Props {
  avaliacoes: Avaliacao[];
  titulo?: string;
  locale: Locale;
}
const { avaliacoes, titulo, locale } = Astro.props;
const ui = t(locale);
import { enfase } from "../lib/texto";
---

{
  avaliacoes.length > 0 && (
    <section class="avaliacoes">
      <h2 set:html={enfase(titulo ?? ui.avaliacoes)} />
      <ul class="grid-cards">
        {avaliacoes.map((a) => (
          <li>
            <figure>
              <p class="nota" aria-label={`${a.nota} de 5`}>
                {"★".repeat(a.nota)}
                <span aria-hidden="true" class="vazias">{"★".repeat(5 - a.nota)}</span>
              </p>
              <blockquote>
                <p>{a.texto}</p>
              </blockquote>
              <figcaption>
                <strong>{a.nomeAutor}</strong>
                <br />
                <span>
                  {ui.avaliacaoEm} <time datetime={a.data}>{formatData(a.data, locale)}</time>
                  {a.urlFonte ? (
                    <>
                      {" — "}
                      <a href={a.urlFonte} rel="noopener nofollow" target="_blank">
                        {ui.verFonte} {a.fonte}
                      </a>
                    </>
                  ) : (
                    ` — ${a.fonte}`
                  )}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  figure {
    position: relative;
    margin: 0;
    height: 100%;
    padding: var(--space-6) var(--space-5) var(--space-5);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-lg) var(--radius-arco) var(--radius-lg) var(--radius-lg);
  }
  .nota {
    color: #8a5a00;
    letter-spacing: 2px;
    margin-bottom: var(--space-3);
  }
  .vazias {
    color: var(--brand-azul-claro);
  }
  blockquote {
    margin: 0 0 var(--space-4);
    font-size: var(--fs-300);
    line-height: 1.5;
    color: var(--brand-poco);
  }
  figcaption {
    font-size: var(--fs-100);
    color: var(--color-text-muted);
  }
  /* Sobre o fundo céu, o azul Saltão fica em 4,2:1 — links usam o azul escuro (8,3:1). */
  figcaption a {
    color: var(--color-primary-strong);
  }
</style>
