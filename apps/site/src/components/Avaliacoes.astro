---
/** Só avaliações reais, sempre com fonte e data visíveis. Sem aggregateRating no schema (decisão 7). */
import type { Avaliacao, Locale } from "../lib/types";
import { formatData, t } from "../lib/i18n";
interface Props {
  avaliacoes: Avaliacao[];
  titulo?: string;
  locale: Locale;
}
const { avaliacoes, titulo, locale } = Astro.props;
const ui = t(locale);
---

{
  avaliacoes.length > 0 && (
    <section class="avaliacoes">
      <h2>{titulo ?? ui.avaliacoes}</h2>
      <ul class="grid-cards">
        {avaliacoes.map((a) => (
          <li>
            <figure>
              <p class="nota" aria-label={`${a.nota} de 5`}>
                {"★".repeat(a.nota)}
                <span aria-hidden="true" class="vazias">{"★".repeat(5 - a.nota)}</span>
              </p>
              <blockquote>
                <p>{a.texto}</p>
              </blockquote>
              <figcaption>
                <strong>{a.nomeAutor}</strong>
                <br />
                <span>
                  {ui.avaliacaoEm} <time datetime={a.data}>{formatData(a.data, locale)}</time>
                  {a.urlFonte ? (
                    <>
                      {" — "}
                      <a href={a.urlFonte} rel="noopener nofollow" target="_blank">
                        {ui.verFonte} {a.fonte}
                      </a>
                    </>
                  ) : (
                    ` — ${a.fonte}`
                  )}
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  figure {
    margin: 0;
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .nota {
    color: #8a5a00;
    letter-spacing: 2px;
    margin-bottom: var(--space-2);
  }
  .vazias {
    color: var(--color-border);
  }
  blockquote {
    margin: 0 0 var(--space-3);
  }
  figcaption {
    font-size: var(--fs-100);
    color: var(--color-text-muted);
  }
</style>
