---
/** Cabeçalho: menu (sem JS — <details> no mobile), seletor de idioma e botão Reservar sempre visível. */
import type { Locale } from "../lib/types";
import type { Indice, Rota } from "../lib/routes";
import { homePath, guiaPath } from "../lib/routes";
import { t } from "../lib/i18n";
import { linkReserva } from "../lib/config";
import Icone from "./Icone.astro";
import logo from "../assets/marca/logo-horizontal.svg";

interface Props {
  rota: Pick<Rota, "locale" | "path" | "alternates">;
  indice: Indice;
}
const { rota, indice } = Astro.props;
const { locale } = rota;
const ui = t(locale);
const c = indice.conteudo;
const g = c.global[locale];

type Link = { rotulo: string; href: string };
type Entrada = { rotulo: string; href?: string; filhos: Link[] };

/** Menu do painel; se vazio, montado a partir das páginas existentes, em grupos de páginas relacionadas. */
let menu: Entrada[] = (g?.menuPrincipal ?? []).map((m) => ({ rotulo: m.rotulo, href: m.link, filhos: (m.subitens ?? []).map((x) => ({ rotulo: x.rotulo, href: x.link })) }));
if (!menu.length) {
  const pagina = (kind: "institucional" | "atendimento", id: string): Link | null => {
    const href = indice.link(kind, id, locale);
    const r = href && indice.porPath.get(href);
    return r && "doc" in r ? { rotulo: (r.doc as { titulo: string }).titulo, href } : null;
  };
  const cats = c.categoriasProduto.filter((x) => x.locale === locale).sort((a, b) => a.ordemMenu - b.ordemMenu);
  const cat = (id: string): Link | null => {
    const x = cats.find((k) => k.documentId === id);
    return x ? { rotulo: x.titulo, href: indice.link("categoria-produto", x.documentId, locale)! } : null;
  };
  const so = (xs: (Link | null)[]) => xs.filter((x): x is Link => x !== null);
  // Hospedagem: a categoria (visão geral) + cada acomodação.
  const hosp = cats.find((k) => k.documentId === "cat-hosp");
  // Em página única (landing), Hospedagem vira link direto para a própria landing.
  const hospFilhos: Link[] = hosp?.paginaUnica
    ? [{ rotulo: hosp.titulo, href: indice.link("categoria-produto", hosp.documentId, locale)! }]
    : hosp
    ? [
        { rotulo: ui.visaoGeral, href: indice.link("categoria-produto", hosp.documentId, locale)! },
        ...hosp.produtoIds.flatMap((id) => {
          const pr = indice.produto(id, locale);
          const href = indice.link("produto", id, locale);
          return pr && href ? [{ rotulo: pr.titulo, href }] : [];
        }),
      ]
    : [];
  const grupos: Entrada[] = [
    { rotulo: ui.grupoParque, filhos: so([pagina("institucional", "inst-conheca"), pagina("institucional", "inst-cachoeira"), pagina("institucional", "inst-restaurante"), pagina("institucional", "inst-seguranca")]) },
    { rotulo: ui.grupoExperiencias, filhos: so([cat("cat-dayuse"), cat("cat-quiosques"), cat("cat-combos")]) },
    hosp ? { rotulo: hosp.titulo.split(/\s+(e|and|y)\s+/)[0], filhos: hospFilhos } : { rotulo: "", filhos: [] },
    ...(indice.porPath.has(guiaPath(locale)) ? [{ rotulo: ui.guiaCurto, href: guiaPath(locale), filhos: [] }] : []),
    { rotulo: ui.grupoAtendimento, filhos: so([pagina("atendimento", "at-faq"), pagina("institucional", "inst-como-chegar"), pagina("atendimento", "at-minha-reserva")]) },
  ];
  // Grupo com um só filho vira link direto.
  menu = grupos.filter((x) => x.href || x.filhos.length).map((x) => (x.filhos.length === 1 ? { rotulo: x.rotulo, href: x.filhos[0].href, filhos: [] } : x));
}
const atual = (href: string) => rota.path === href || (href !== homePath(locale) && rota.path.startsWith(href));
const grupoAtivo = (e: Entrada) => (e.href ? atual(e.href) : false) || e.filhos.some((f) => atual(f.href));

const NOMES: Record<Locale, string> = { pt: "Português", en: "English", es: "Español" };
const SIGLA: Record<Locale, string> = { pt: "PT", en: "EN", es: "ES" };
const idiomas = (Object.keys(NOMES) as Locale[]).map((l) => ({ l, href: rota.alternates[l] ?? homePath(l) }));
---

<header class="cabecalho">
  <div class="container barra">
    <a class="marca" href={homePath(locale)}>
      <img src={logo.src} width="151" height="44" alt={`${g?.nomeOficial ?? "Saltão"} — ${ui.inicio}`} />
    </a>

    <nav class="nav-desktop" aria-label={ui.menu}>
      <ul class="itens">
        {
          menu.map((m) =>
            m.filhos.length ? (
              <li class="grupo">
                <details name="menu-principal">
                  <summary class={grupoAtivo(m) ? "ativo" : undefined}>
                    {m.rotulo}
                    <svg class="seta" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </summary>
                  <ul class="sub">
                    {m.filhos.map((f) => (
                      <li>
                        <a href={f.href} aria-current={atual(f.href) ? "page" : undefined}>{f.rotulo}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={m.href} aria-current={atual(m.href!) ? "page" : undefined}>{m.rotulo}</a>
              </li>
            ),
          )
        }
      </ul>
      <ul class="idiomas" aria-label={ui.idioma}>
        {
          idiomas.map(({ l, href }) => (
            <li>
              <a href={href} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>
                <abbr title={NOMES[l]}>{SIGLA[l]}</abbr>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="menu-mobile">
      <summary><span>{ui.menu}</span></summary>
      <nav aria-label={ui.menu}>
        <ul class="itens">
          {
            menu.map((m) =>
              m.filhos.length ? (
                <li class="grupo-mobile">
                  <span class="grupo-titulo">{m.rotulo}</span>
                  <ul>
                    {m.filhos.map((f) => (
                      <li>
                        <a href={f.href} aria-current={atual(f.href) ? "page" : undefined}>{f.rotulo}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={m.href} aria-current={atual(m.href!) ? "page" : undefined}>{m.rotulo}</a>
                </li>
              ),
            )
          }
        </ul>
        <ul class="idiomas" aria-label={ui.idioma}>
          {
            idiomas.map(({ l, href }) => (
              <li>
                <a href={href} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>
                  <abbr title={NOMES[l]}>{SIGLA[l]}</abbr>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <a class="btn reservar" href={linkReserva({ lang: locale })} data-dl='{"event":"click_reservar","method":"cabecalho"}'>
      <Icone nome="calendario" tamanho={18} />
      {ui.reservar}
      <Icone nome="seta" tamanho={16} class="seta" />
    </a>
  </div>
</header>

<style>
  /* O cabeçalho é transparente: só a barra (do logo ao Reservar) é branca. Na home a foto do hero
     sobe por trás dele e aparece dos dois lados da barra. */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 50;
    pointer-events: none;
  }
  .barra {
    --r-barra: 1.5rem;
    position: relative;
    /* Margem lateral = raio dos cantos côncavos, senão eles passam da tela (rolagem horizontal). */
    width: min(100% - 2 * var(--r-barra), 92rem);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 4.5rem;
    padding-inline: clamp(var(--space-3), 2vw, var(--space-6));
    background: var(--color-bg);
    border-radius: 0 0 var(--r-barra) var(--r-barra);
    box-shadow: 0 10px 30px -18px rgb(15 39 68 / 0.45);
    pointer-events: auto;
  }
  /* Cantos côncavos no topo: a barra "escorre" da borda da tela, como água saindo da pedra. */
  .barra::before,
  .barra::after {
    content: "";
    position: absolute;
    top: 0;
    width: var(--r-barra);
    height: var(--r-barra);
    pointer-events: none;
  }
  .barra::before {
    right: 100%;
    background: radial-gradient(circle at 0 100%, transparent calc(var(--r-barra) - 0.5px), var(--color-bg) var(--r-barra));
  }
  .barra::after {
    left: 100%;
    background: radial-gradient(circle at 100% 100%, transparent calc(var(--r-barra) - 0.5px), var(--color-bg) var(--r-barra));
  }
  .marca {
    margin-right: auto;
    display: block;
    flex-shrink: 0;
  }
  .marca img {
    width: 151px;
    max-width: none;
    height: 44px;
  }
  @media (max-width: 30rem) {
    .barra {
      gap: var(--space-2);
      padding-inline: var(--space-3);
    }
  }
  @media (max-width: 26rem) {
    .marca img {
      width: 124px;
      height: 36px;
    }
  }
  /* Reservar: pílula no azul do poço, como o botão do layout. */
  .reservar {
    flex-shrink: 0;
    min-height: 44px;
    padding-inline: var(--space-4);
    background: var(--brand-poco);
    color: #ffffff;
    font-size: var(--fs-100);
  }
  .reservar:hover {
    background: var(--brand-azul-escuro);
    color: #ffffff;
  }
  @media (max-width: 30rem) {
    .reservar :global(svg) {
      display: none;
    }
  }
  summary {
    cursor: pointer;
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding-inline: var(--space-4);
    font-weight: var(--fw-medio);
  }
  .menu-mobile[open] summary {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: var(--space-3) var(--space-4);
    color: var(--color-text);
    text-decoration: none;
    font-weight: var(--fw-medio);
  }
  nav a:hover {
    color: var(--color-primary);
  }
  nav a[aria-current="page"],
  nav a[aria-current="true"] {
    color: var(--color-primary);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
    text-decoration-color: var(--brand-azul-medio);
  }
  .idiomas {
    display: flex;
    border-top: 1px solid var(--color-border);
  }
  abbr {
    text-decoration: none;
  }
  .nav-desktop {
    display: none;
  }
  .menu-mobile {
    order: 3;
  }
  .menu-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--color-bg);
    box-shadow: var(--shadow-md);
    padding: var(--space-3) 0 var(--space-2);
  }
  .menu-mobile nav {
    max-height: calc(100svh - 4.5rem);
    overflow-y: auto;
  }
  .grupo-mobile {
    padding-top: var(--space-2);
  }
  .grupo-titulo {
    display: block;
    padding: var(--space-2) var(--space-4) 0;
    font-size: var(--fs-100);
    color: var(--color-text-muted);
  }
  .grupo-mobile a {
    padding-left: var(--space-6);
  }
  /* Menu completo a partir de 70rem; abaixo disso, botão Menu. */
  @media (min-width: 70rem) {
    .menu-mobile {
      display: none;
    }
    .nav-desktop {
      flex: 1;
      justify-content: center;
    }
    .nav-desktop,
    .nav-desktop > ul {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      white-space: nowrap;
    }
    .nav-desktop .itens {
      gap: var(--space-1);
    }
    .nav-desktop .itens > li > a,
    .grupo summary {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      min-height: 44px;
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-pill);
      color: var(--color-text);
      font-weight: var(--fw-medio);
      text-decoration: none;
    }
    .grupo {
      position: relative;
    }
    .grupo summary {
      cursor: pointer;
      list-style: none;
      border: 0;
    }
    .grupo summary::-webkit-details-marker {
      display: none;
    }
    .grupo summary:hover,
    .nav-desktop .itens > li > a:hover,
    .grupo details[open] summary {
      background: var(--color-surface);
      color: var(--color-primary-strong);
    }
    .grupo summary.ativo {
      color: var(--color-primary);
    }
    .seta {
      transition: transform 0.15s ease;
    }
    .grupo details[open] .seta {
      transform: rotate(180deg);
    }
    /* Painel do submenu: branco, com o fio dos arcos no topo. */
    /* .nav-desktop na frente para vencer o reset "nav ul { padding: 0 }". */
    .nav-desktop .sub {
      position: absolute;
      top: calc(100% + var(--space-2));
      left: 0;
      min-width: 17rem;
      padding: var(--space-3) var(--space-5) var(--space-3);
      background: var(--grad-arcos) top / 100% 3px no-repeat, var(--color-bg);
      border-radius: var(--radius-md) var(--radius-lg) var(--radius-lg) var(--radius-lg);
      box-shadow: var(--shadow-md);
    }
    /* Itens com mais respiro e um fio fino entre eles (some nas pontas, como água). */
    .sub li + li {
      background: linear-gradient(to right, transparent, var(--color-border) 12%, var(--color-border) 88%, transparent) top / 100% 1px no-repeat;
    }
    .sub a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      min-height: 3rem;
      padding: var(--space-3) var(--space-1);
      font-size: var(--fs-100);
      font-weight: var(--fw-medio);
      color: var(--brand-poco);
      text-decoration: none;
      transition: color 0.2s ease, transform 0.2s ease;
    }
    /* Seta discreta que aparece no hover/foco. */
    .sub a::after {
      content: "";
      flex-shrink: 0;
      width: 0.45rem;
      height: 0.45rem;
      border-top: 1.6px solid currentColor;
      border-right: 1.6px solid currentColor;
      transform: rotate(45deg);
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .sub a:hover,
    .sub a:focus-visible {
      color: var(--color-primary-strong);
      transform: translateX(3px);
    }
    .sub a:hover::after,
    .sub a:focus-visible::after,
    .sub a[aria-current="page"]::after {
      opacity: 1;
    }
    .sub a[aria-current="page"] {
      color: var(--color-primary-strong);
    }
    @media (prefers-reduced-motion: reduce) {
      .sub a {
        transition: none;
      }
      .sub a:hover,
      .sub a:focus-visible {
        transform: none;
      }
    }
    .nav-desktop .idiomas {
      border-top: 0;
      border-left: 1px solid var(--color-border);
      margin-left: var(--space-3);
      padding-left: var(--space-2);
    }
    .nav-desktop .idiomas a {
      padding: var(--space-2);
      font-size: var(--fs-100);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seta {
      transition: none;
    }
  }
</style>
