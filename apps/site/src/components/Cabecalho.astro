---
/**
 * Cabeçalho direto sobre a foto (ou a faixa escura do topo), sem fundo — só uma sombra preta suave.
 * Menu sem JS (<details> no mobile), seletor de idioma e botão Reservar sempre visível.
 */
import type { Locale } from "../lib/types";
import type { Indice, Rota } from "../lib/routes";
import { homePath, guiaPath } from "../lib/routes";
import { t } from "../lib/i18n";
import { linkReserva } from "../lib/config";
import logo from "../assets/marca/logo-horizontal.svg";

interface Props {
  rota: Pick<Rota, "locale" | "path" | "alternates">;
  indice: Indice;
}
const { rota, indice } = Astro.props;
const { locale } = rota;
const ui = t(locale);
const c = indice.conteudo;
const g = c.global[locale];

type Link = { rotulo: string; href: string };
type Entrada = { rotulo: string; href?: string; filhos: Link[] };

/** Menu do painel; se vazio, montado a partir das páginas existentes, em grupos de páginas relacionadas. */
let menu: Entrada[] = (g?.menuPrincipal ?? []).map((m) => ({ rotulo: m.rotulo, href: m.link, filhos: (m.subitens ?? []).map((x) => ({ rotulo: x.rotulo, href: x.link })) }));
if (!menu.length) {
  const pagina = (kind: "institucional" | "atendimento", id: string): Link | null => {
    const href = indice.link(kind, id, locale);
    const r = href && indice.porPath.get(href);
    return r && "doc" in r ? { rotulo: (r.doc as { titulo: string }).titulo, href } : null;
  };
  const cats = c.categoriasProduto.filter((x) => x.locale === locale).sort((a, b) => a.ordemMenu - b.ordemMenu);
  const cat = (id: string): Link | null => {
    const x = cats.find((k) => k.documentId === id);
    return x ? { rotulo: x.titulo, href: indice.link("categoria-produto", x.documentId, locale)! } : null;
  };
  const so = (xs: (Link | null)[]) => xs.filter((x): x is Link => x !== null);
  // Cada acomodação (Apartamentos, Camping) vira item próprio do menu.
  const hosp = cats.find((k) => k.documentId === "cat-hosp");
  const acomodacoes: Entrada[] = (hosp?.produtoIds ?? []).flatMap((id) => {
    const pr = indice.produto(id, locale);
    const href = indice.link("produto", id, locale);
    return pr && href ? [{ rotulo: pr.titulo, href, filhos: [] }] : [];
  });
  const dayuse = cats.find((k) => k.documentId === "cat-dayuse");
  // Cachoeiras: item de destaque, logo no início (a página forte do site atual).
  const cachoeiras = pagina("institucional", "inst-cachoeira");
  const grupos: Entrada[] = [
    ...(cachoeiras ? [{ rotulo: ui.cachoeiras, href: cachoeiras.href, filhos: [] }] : []),
    { rotulo: dayuse?.titulo ?? "Day Use", filhos: so([dayuse ? { rotulo: ui.visaoGeral, href: indice.link("categoria-produto", dayuse.documentId, locale)! } : null, cat("cat-quiosques")]) },
    ...acomodacoes,
    { rotulo: ui.grupoParque, filhos: so([pagina("institucional", "inst-conheca"), pagina("institucional", "inst-restaurante"), pagina("institucional", "inst-seguranca")]) },
    ...(indice.porPath.has(guiaPath(locale)) ? [{ rotulo: ui.guiaCurto, href: guiaPath(locale), filhos: [] }] : []),
    { rotulo: ui.grupoAtendimento, filhos: so([pagina("atendimento", "at-faq"), pagina("institucional", "inst-como-chegar"), pagina("atendimento", "at-minha-reserva")]) },
  ];
  // Grupo com um só filho vira link direto.
  menu = grupos.filter((x) => x.href || x.filhos.length).map((x) => (x.filhos.length === 1 ? { rotulo: x.rotulo, href: x.filhos[0].href, filhos: [] } : x));
}
const atual = (href: string) => rota.path === href || (href !== homePath(locale) && rota.path.startsWith(href));
const grupoAtivo = (e: Entrada) => (e.href ? atual(e.href) : false) || e.filhos.some((f) => atual(f.href));

const NOMES: Record<Locale, string> = { pt: "Português", en: "English", es: "Español" };
const SIGLA: Record<Locale, string> = { pt: "PT", en: "EN", es: "ES" };
const idiomas = (Object.keys(NOMES) as Locale[]).map((l) => ({ l, href: rota.alternates[l] ?? homePath(l) }));
---

<header class="cabecalho">
  <div class="container barra">
    <a class="marca" href={homePath(locale)}>
      <img src={logo.src} width="151" height="44" alt={`${g?.nomeOficial ?? "Saltão"} — ${ui.inicio}`} />
    </a>

    <nav class="nav-desktop" aria-label={ui.menu}>
      <ul class="itens">
        {
          menu.map((m) =>
            m.filhos.length ? (
              <li class="grupo">
                <details name="menu-principal">
                  <summary class={grupoAtivo(m) ? "ativo" : undefined}>
                    {m.rotulo}
                    <svg class="seta" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </summary>
                  <ul class="sub">
                    {m.filhos.map((f) => (
                      <li>
                        <a href={f.href} aria-current={atual(f.href) ? "page" : undefined}>{f.rotulo}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={m.href} aria-current={atual(m.href!) ? "page" : undefined}>{m.rotulo}</a>
              </li>
            ),
          )
        }
      </ul>
      <ul class="idiomas" aria-label={ui.idioma}>
        {
          idiomas.map(({ l, href }) => (
            <li>
              <a href={href} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>
                <abbr title={NOMES[l]}>{SIGLA[l]}</abbr>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="menu-mobile">
      <summary><span>{ui.menu}</span></summary>
      <nav aria-label={ui.menu}>
        <ul class="itens">
          {
            menu.map((m) =>
              m.filhos.length ? (
                <li class="grupo-mobile">
                  <span class="grupo-titulo">{m.rotulo}</span>
                  <ul>
                    {m.filhos.map((f) => (
                      <li>
                        <a href={f.href} aria-current={atual(f.href) ? "page" : undefined}>{f.rotulo}</a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={m.href} aria-current={atual(m.href!) ? "page" : undefined}>{m.rotulo}</a>
                </li>
              ),
            )
          }
        </ul>
        <ul class="idiomas" aria-label={ui.idioma}>
          {
            idiomas.map(({ l, href }) => (
              <li>
                <a href={href} hreflang={l} lang={l} aria-current={l === locale ? "true" : undefined}>
                  <abbr title={NOMES[l]}>{SIGLA[l]}</abbr>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <a class="btn btn-claro reservar" href={linkReserva({ lang: locale })}>{ui.reservar}</a>
  </div>
</header>

<style>
  /* Direto sobre a foto: sem fundo, só uma sombra preta suave no alto para a leitura.
     Não é fixo — aparece sobre a foto/faixa do topo e sobe com a página. */
  .cabecalho {
    position: absolute;
    inset: 0 0 auto;
    z-index: 50;
    color: #ffffff;
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.45) 0%, rgb(0 0 0 / 0.18) 60%, rgb(0 0 0 / 0) 100%);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.35);
  }
  .barra {
    width: min(100% - 2 * var(--space-4), 92rem);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--altura-cabecalho);
  }
  .marca {
    margin-right: auto;
    display: block;
    flex-shrink: 0;
  }
  /* Logo em branco sobre o azul (mesmo SVG, sem segundo arquivo). */
  .marca img {
    width: 151px;
    max-width: none;
    height: 44px;
    filter: brightness(0) invert(1);
  }
  @media (max-width: 23rem) {
    .marca img {
      width: 124px;
      height: 36px;
    }
  }
  .reservar {
    flex-shrink: 0;
    min-height: 44px;
    padding-inline: var(--space-5);
  }
  summary {
    cursor: pointer;
    list-style: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: var(--radius-pill);
    font-weight: var(--fw-medio);
  }
  .menu-mobile[open] summary {
    background: #ffffff;
    border-color: #ffffff;
    color: var(--brand-azul-escuro);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: var(--space-3) var(--space-4);
    color: #ffffff;
    text-decoration: none;
    font-weight: var(--fw-medio);
  }
  nav a:hover {
    color: var(--brand-azul-claro);
  }
  nav a[aria-current="page"],
  nav a[aria-current="true"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
    text-decoration-color: var(--brand-azul-claro);
  }
  .idiomas {
    display: flex;
    border-top: 1px solid var(--color-linha-clara);
  }
  abbr {
    text-decoration: none;
  }
  .nav-desktop {
    display: none;
  }
  .menu-mobile {
    order: 3;
  }
  /* Painel do menu no celular: poço sólido, links brancos. */
  .menu-mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100svh - var(--altura-cabecalho));
    overflow-y: auto;
    padding: var(--space-3) 0 var(--space-2);
    background: rgb(10 14 20 / 0.96);
    box-shadow: var(--shadow-md);
    text-shadow: none;
  }
  .grupo-mobile {
    padding-top: var(--space-2);
  }
  .grupo-titulo {
    display: block;
    padding: var(--space-2) var(--space-4) 0;
    font-size: var(--fs-100);
    color: var(--color-on-deep-muted);
  }
  .grupo-mobile a {
    padding-left: var(--space-6);
  }
  /* Menu completo a partir de 70rem; abaixo disso, botão Menu. */
  @media (min-width: 70rem) {
    .menu-mobile {
      display: none;
    }
    .nav-desktop,
    .nav-desktop > ul {
      display: flex;
      align-items: center;
      flex-wrap: nowrap;
      white-space: nowrap;
    }
    .nav-desktop .itens {
      gap: var(--space-1);
    }
    .nav-desktop .itens > li > a,
    .grupo summary {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      min-height: 44px;
      padding: var(--space-2) var(--space-3);
      border: 0;
      border-radius: var(--radius-pill);
      color: #ffffff;
      font-weight: var(--fw-medio);
      text-decoration: none;
    }
    .grupo {
      position: relative;
    }
    .grupo summary::-webkit-details-marker {
      display: none;
    }
    .grupo summary:hover,
    .nav-desktop .itens > li > a:hover,
    .grupo details[open] summary {
      background: rgb(255 255 255 / 0.14);
      color: #ffffff;
    }
    .grupo summary.ativo,
    .nav-desktop .itens > li > a[aria-current="page"] {
      box-shadow: inset 0 -2px 0 var(--brand-azul-claro);
      border-radius: var(--radius-sm);
      text-decoration: none;
    }
    .seta {
      transition: transform 0.15s ease;
    }
    .grupo details[open] .seta {
      transform: rotate(180deg);
    }
    /* Painel do submenu: branco, com o fio dos arcos no topo. */
    .sub {
      text-shadow: none;
      position: absolute;
      top: calc(100% + var(--space-2));
      left: 0;
      min-width: 15rem;
      padding: var(--space-3) var(--space-2) var(--space-2);
      background: var(--grad-arcos) top / 100% 3px no-repeat, var(--color-bg);
      border-radius: var(--radius-md) var(--radius-lg) var(--radius-lg) var(--radius-lg);
      box-shadow: var(--shadow-md);
    }
    .sub a {
      padding: var(--space-2) var(--space-3);
      border-radius: var(--radius-sm);
      font-size: var(--fs-100);
      color: var(--color-text);
    }
    .sub a:hover {
      background: var(--color-surface);
      color: var(--color-primary-strong);
    }
    .sub a[aria-current="page"] {
      color: var(--color-primary-strong);
      text-decoration-color: var(--brand-azul-medio);
    }
    .nav-desktop .idiomas {
      border-top: 0;
      border-left: 1px solid var(--color-linha-clara);
      margin-left: var(--space-3);
      padding-left: var(--space-2);
    }
    .nav-desktop .idiomas a {
      padding: var(--space-2);
      font-size: var(--fs-100);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seta {
      transition: none;
    }
  }
</style>
