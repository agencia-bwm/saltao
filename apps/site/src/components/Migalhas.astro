---
import type { Migalha } from "../lib/routes";
interface Props {
  itens: Migalha[];
  /** Texto branco, para usar sobre foto escura. */
  claro?: boolean;
}
const { itens, claro = false } = Astro.props;
---

{
  itens.length > 1 && (
    <nav aria-label="Breadcrumb" class:list={["migalhas", { container: !claro, claro }]}>
      <ol>
        {itens.map((m, i) =>
          i === itens.length - 1 ? (
            <li aria-current="page">{m.nome}</li>
          ) : (
            <li>
              <a href={m.path}>{m.nome}</a>
            </li>
          ),
        )}
      </ol>
    </nav>
  )
}

<style>
  .claro,
  .claro a,
  .claro li {
    color: var(--color-on-deep);
  }
  .migalhas.claro {
    padding-top: 0;
    margin-bottom: var(--space-5);
  }
  .migalhas {
    font-size: var(--fs-100);
    padding-top: var(--space-4);
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li + li::before {
    content: "›";
    margin-right: var(--space-2);
    color: var(--color-text-muted);
  }
  li[aria-current] {
    color: var(--color-text-muted);
  }
</style>
