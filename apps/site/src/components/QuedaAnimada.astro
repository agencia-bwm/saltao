---
/**
 * Queda d'água animada sobre a foto do hero — só SVG + CSS, sem JavaScript.
 * O SVG usa o mesmo enquadramento da foto (viewBox nas medidas dela + "xMidYMid slice" = object-fit: cover),
 * então os fios d'água ficam em cima da queda em qualquer tela. Posição vem do painel, em % da foto.
 * Com "reduzir movimento" ligado no sistema, nada se mexe.
 */
import type { QuedaAnimada } from "../lib/types";

interface Props {
  queda: QuedaAnimada;
  largura: number;
  altura: number;
}
const { queda: q, largura: W, altura: H } = Astro.props;
const px = (v: number) => Math.round((v / 100) * W);
const py = (v: number) => Math.round((v / 100) * H);
const y1 = py(q.topo);
const y2 = py(q.base);
const t0 = px(q.xTopo - q.larguraTopo / 2);
const t1 = px(q.xTopo + q.larguraTopo / 2);
const b0 = px(q.xBase - q.larguraBase / 2);
const b1 = px(q.xBase + q.larguraBase / 2);
const N = 22;
// Período do tracejado (traço + vão) — o mesmo da animação em CSS (stroke-dashoffset 0 → -240).
const padroes = ["30 210", "70 170", "16 224", "110 130"];
const fios = Array.from({ length: N }, (_, i) => {
  const f = (i + 0.5) / N;
  return { x1: Math.round(t0 + f * (t1 - t0)), x2: Math.round(b0 + f * (b1 - b0)), dash: padroes[(i * 3) % 4], cls: `f${i % 4} e${i % 3}` };
});
---

<svg class="queda" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id="queda-recorte">
      <polygon points={`${t0},${y1} ${t1},${y1} ${b1},${y2} ${b0},${y2}`} />
    </clipPath>
    <radialGradient id="queda-nevoa">
      <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <g clip-path="url(#queda-recorte)">
    {fios.map((l) => <line class={l.cls} x1={l.x1} y1={y1} x2={l.x2} y2={y2} stroke-dasharray={l.dash} />)}
  </g>
  <ellipse class="nevoa" cx={Math.round((b0 + b1) / 2)} cy={y2} rx={Math.round((b1 - b0) * 1.3)} ry={Math.round((b1 - b0) * 0.42)} fill="url(#queda-nevoa)" />
</svg>

<style>
  .queda {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* Desfoque leve: fios macios, como água, em vez de traços duros. */
  g {
    filter: blur(1.4px);
  }
  line {
    stroke: #ffffff;
    stroke-linecap: round;
    fill: none;
    animation: cair 1s linear infinite;
  }
  .e0 {
    stroke-width: 4;
    opacity: 0.35;
  }
  .e1 {
    stroke-width: 8;
    opacity: 0.18;
  }
  .e2 {
    stroke-width: 2.5;
    opacity: 0.5;
  }
  .f0 {
    animation-duration: 0.85s;
  }
  .f1 {
    animation-duration: 1.1s;
    animation-delay: -0.4s;
  }
  .f2 {
    animation-duration: 0.95s;
    animation-delay: -0.7s;
  }
  .f3 {
    animation-duration: 1.25s;
    animation-delay: -0.2s;
  }
  @keyframes cair {
    to {
      stroke-dashoffset: -240;
    }
  }
  .nevoa {
    transform-box: fill-box;
    transform-origin: center;
    animation: nevoa 3.2s ease-in-out infinite alternate;
  }
  @keyframes nevoa {
    from {
      opacity: 0.55;
      transform: scale(0.92);
    }
    to {
      opacity: 1;
      transform: scale(1.08);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .queda {
      display: none;
    }
  }
</style>
