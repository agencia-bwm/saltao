---
/** Fatos objetivos e citáveis em texto (GEO): altura da cachoeira, capacidade, distâncias. */
import type { KV } from "../lib/types";
interface Props {
  itens: KV[];
  titulo?: string;
}
const { itens, titulo } = Astro.props;
import { enfase } from "../lib/texto";
---

<section class="fatos no-escuro">
  {titulo && <h2 set:html={enfase(titulo)} />}
  <dl>
    {
      itens.map((f) => (
        <div>
          <dt>{f.chave}</dt>
          <dd>{f.valor}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* Faixa funda: o meio da descida (azul Saltão → poço), com o canto do arco. */
  .fatos {
    margin-block: var(--space-8);
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    background: var(--grad-profundo);
    color: var(--color-on-deep);
    border-radius: var(--radius-lg) var(--radius-arco) var(--radius-lg) var(--radius-lg);
  }
  h2 {
    margin: 0 0 var(--space-6);
    color: #ffffff;
    font-size: var(--fs-400);
    font-weight: var(--fw-medio);
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-6) var(--space-5);
    margin: 0;
  }
  dl > div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 2px solid rgb(160 201 232 / 0.4);
  }
  /* O primeiro fato ocupa a linha toda e vira o número grande. */
  dl > div:first-child {
    grid-column: 1 / -1;
    padding-left: 0;
    border-left: 0;
  }
  dt {
    color: var(--color-on-deep-muted);
    font-size: var(--fs-100);
  }
  dd {
    margin: 0;
    font-size: var(--fs-500);
    font-weight: var(--fw-leve);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    color: #ffffff;
  }
  dl > div:first-child dd {
    font-size: var(--fs-700);
    font-weight: 200;
    letter-spacing: -0.05em;
    /* O número desce em degradê, do azul claro ao branco, como a água caindo. */
    background: linear-gradient(180deg, var(--brand-azul-claro) 0%, #ffffff 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  dl > div:first-child dt {
    font-size: var(--fs-300);
  }
  /* No computador: o número grande à esquerda, os outros alinhados pela base à direita. */
  @media (min-width: 52rem) {
    dl {
      grid-template-columns: minmax(0, 1.6fr) repeat(auto-fit, minmax(8rem, 1fr));
      align-items: end;
    }
    dl > div:first-child {
      grid-column: auto;
    }
  }
</style>
