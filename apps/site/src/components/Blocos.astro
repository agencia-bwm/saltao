---
/** Renderiza as dynamic zones (Home, Institucional, corpo do Artigo). Um componente por bloco do Figma. */
import type { Block, Locale } from "../lib/types";
import type { Indice } from "../lib/routes";
import { t } from "../lib/i18n";
import RichText from "./RichText.astro";
import Foto from "./Foto.astro";
import Tabela from "./Tabela.astro";
import Fatos from "./Fatos.astro";
import FaqLista from "./FaqLista.astro";
import Avaliacoes from "./Avaliacoes.astro";
import CardProduto from "./CardProduto.astro";
import VideoFachada from "./VideoFachada.astro";
import Roteiro from "./Roteiro.astro";
import ChamadaFinal from "./ChamadaFinal.astro";
import { enfase } from "../lib/texto";

interface Props {
  blocos: Block[];
  indice: Indice;
  locale: Locale;
  /** Largura de leitura (artigos) ou de página (home). */
  estreito?: boolean;
  /** Página sem hero (Institucional): a primeira imagem nos 2 primeiros blocos é a imagem LCP. */
  prioridadeTopo?: boolean;
  /** Home: títulos com destaque (*palavra*), cards em foto e citação grande. */
  home?: boolean;
}
const { blocos, indice, locale, estreito = false, prioridadeTopo = false, home = false } = Astro.props;
const iDestaques = blocos.findIndex((b) => b.__component === "blocks.destaques-produtos");
const iImagemLcp = prioridadeTopo ? blocos.findIndex((b, i) => i <= 1 && b.__component === "blocks.imagem") : -1;
const ui = t(locale);
const sizesLargura = estreito ? "(min-width: 46rem) 46rem, 100vw" : "(min-width: 72rem) 72rem, 100vw";
---

{
  blocos.map((b, i) => {
    switch (b.__component) {
      case "blocks.texto":
        return <RichText conteudo={b.conteudo} />;
      case "blocks.imagem":
        if (home)
          return (
            <section class="panoramica">
              <figure>
                <Foto img={b.imagem} sizes="100vw" larguras={[640, 960, 1280, 1600, 1920]} />
                {b.imagem.caption && <figcaption>{b.imagem.caption}</figcaption>}
              </figure>
            </section>
          );
        return (
          <figure class="bloco-imagem">
            <Foto img={b.imagem} sizes={sizesLargura} prioridade={i === iImagemLcp} />
            {b.imagem.caption && <figcaption>{b.imagem.caption}</figcaption>}
          </figure>
        );
      case "blocks.tabela":
        return <Tabela tabela={b} />;
      case "blocks.citacao":
        if (home)
          return (
            <section class="frase">
              <svg class="frase-arcos" viewBox="166 62 118 166" aria-hidden="true" focusable="false">
                <path fill="#489ed2" d="M239.58 73.19c-4.78-2.11-9.34-3.38-13.55-3.55-48.59-1.9-53.53 26.05-53.53 90.66 0 19.02 2.39 40.3 6.97 60.88-1.26-15.83-1.66-32.09-1.66-47.49 0-62.75 16.3-98.48 61.77-100.5Z" />
                <path fill="#4076b6" d="M258.58 73.19c-4.79-2.11-9.34-3.38-13.55-3.55-48.61-1.9-53.54 26.05-53.54 90.66 0 19.02 2.4 40.3 6.98 60.88-1.26-15.83-1.67-32.09-1.67-47.49 0-62.75 16.31-98.48 61.78-100.5Z" />
                <path fill="#a0c9e8" d="M278.53 73.33c-4.78-2.11-9.34-3.38-13.55-3.55-48.6-1.9-53.53 26.05-53.53 90.66 0 19.02 2.38 40.31 6.97 60.88-1.25-15.82-1.66-32.09-1.66-47.5 0-62.73 16.31-98.47 61.77-100.49Z" />
              </svg>
              <blockquote>
                <p set:html={enfase(b.texto)} />
                {b.autor && <cite>{b.autor}</cite>}
              </blockquote>
            </section>
          );
        return (
          <blockquote class="citacao">
            <p>{b.texto}</p>
            {b.autor && <cite>{b.autor}</cite>}
          </blockquote>
        );
      case "blocks.fatos":
        return <Fatos itens={b.itens} titulo={b.titulo} />;
      case "blocks.faq":
        return <FaqLista itens={b.itens} titulo={b.titulo} id={`faq-${i}`} />;
      case "blocks.avaliacoes":
        return <Avaliacoes avaliacoes={b.avaliacaoIds.map((id) => indice.avaliacao(id)).filter((a) => a !== undefined)} titulo={b.titulo} locale={locale} />;
      case "blocks.video":
        return <VideoFachada url={b.url} poster={b.poster} titulo={b.titulo} locale={locale} />;
      case "blocks.mapa-estatico":
        return (
          <figure class="bloco-mapa">
            <a href={b.linkMaps} rel="noopener" target="_blank" data-dl='{"event":"click_directions","method":"mapa"}'>
              <Foto img={b.imagem} sizes={sizesLargura} />
              <span class="btn btn-secundario">{ui.abrirMapa}</span>
            </a>
          </figure>
        );
      case "blocks.cta-produto": {
        const p = indice.produto(b.produtoId, locale);
        const href = indice.link("produto", b.produtoId, locale);
        if (!p || !href) return null;
        return (
          <aside class="cta-produto">
            <p>
              <strong>{p.titulo}</strong>
              {b.textoChamada && <><br />{b.textoChamada}</>}
            </p>
            <a class="btn btn-reservar" href={href}>
              {ui.verDetalhes}
            </a>
          </aside>
        );
      }
      case "blocks.destaques-produtos": {
        const itens = b.produtoIds
          .map((id) => ({ p: indice.produto(id, locale), href: indice.link("produto", id, locale) }))
          .filter((x) => x.p && x.href);
        if (home)
          return (
            <section class="destaques" id={i === iDestaques ? "experiencias" : undefined}>
              {b.titulo && <h2 set:html={enfase(b.titulo)} />}
              <ul class="trilho-cards">
                {itens.map(({ p, href }, idx) => (
                  <li>
                    <CardProduto produto={p!} href={href!} categoria={indice.categoriaProduto(p!.categoriaId, locale)} locale={locale} lista={b.titulo ?? "destaques"} index={idx} variante="foto" />
                  </li>
                ))}
              </ul>
            </section>
          );
        return (
          <section class="destaques">
            {b.titulo && <h2>{b.titulo}</h2>}
            <ul class="grid-cards">
              {itens.map(({ p, href }, idx) => (
                <li>
                  <CardProduto produto={p!} href={href!} categoria={indice.categoriaProduto(p!.categoriaId, locale)} locale={locale} lista={b.titulo ?? "destaques"} index={idx} />
                </li>
              ))}
            </ul>
          </section>
        );
      }
      case "blocks.roteiro":
        return <Roteiro titulo={b.titulo} itens={b.itens} />;
      case "blocks.chamada-final":
        return <ChamadaFinal titulo={b.titulo} texto={b.texto} imagem={b.imagem} cta={b.cta} indice={indice} locale={locale} />;
      default:
        return null;
    }
  })
}

<style>
  .bloco-imagem,
  .bloco-mapa {
    margin: var(--space-6) 0;
  }
  .bloco-imagem :global(img),
  .bloco-mapa :global(img) {
    border-radius: var(--radius-lg) var(--radius-arco) var(--radius-lg) var(--radius-lg);
    width: 100%;
  }
  figcaption {
    font-size: var(--fs-100);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }
  .bloco-mapa a {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    text-decoration: none;
  }
  .citacao {
    border-left: 3px solid var(--brand-azul-medio);
    padding-left: var(--space-5);
    font-size: var(--fs-300);
  }
  .cta-produto {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-6);
    margin: var(--space-7) 0;
    background: var(--grad-arcos) left top / 100% 3px no-repeat, var(--color-bg);
    box-shadow: var(--shadow-card);
    border-radius: var(--radius-lg) var(--radius-arco) var(--radius-lg) var(--radius-lg);
  }
  .cta-produto strong {
    font-size: var(--fs-300);
    color: var(--brand-poco);
  }
  .cta-produto p {
    margin: 0;
  }
</style>
