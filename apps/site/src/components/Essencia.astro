---
/** Bloco "Essência": mosaico de até 3 fotos em recortes orgânicos + texto e ícones com rótulo. */
import type { Block } from "../lib/types";
import Foto from "./Foto.astro";
import Icone from "./Icone.astro";

type Props = Extract<Block, { __component: "blocks.essencia" }>;
const { sobretitulo, titulo, tituloDestaque, texto, fotos, itens } = Astro.props;
// Recortes do mosaico: alta à esquerda, quadrada à direita, larga embaixo.
const formatos = [
  { cls: "m1", proporcao: 1 / 1.08, sizes: "(min-width: 64rem) 19rem, 48vw" },
  { cls: "m2", proporcao: 1, sizes: "(min-width: 64rem) 15rem, 40vw" },
  { cls: "m3", proporcao: 2 / 1, sizes: "(min-width: 64rem) 30rem, 78vw" },
];
---

<section class="essencia">
  <div class="mosaico">
    <span class="mancha" aria-hidden="true"></span>
    <svg class="arcos" viewBox="166 62 118 166" aria-hidden="true" focusable="false">
      <path fill="#489ed2" d="M239.58 73.19c-4.78-2.11-9.34-3.38-13.55-3.55-48.59-1.9-53.53 26.05-53.53 90.66 0 19.02 2.39 40.3 6.97 60.88-1.26-15.83-1.66-32.09-1.66-47.49 0-62.75 16.3-98.48 61.77-100.5Z" />
      <path fill="#4076b6" d="M258.58 73.19c-4.79-2.11-9.34-3.38-13.55-3.55-48.61-1.9-53.54 26.05-53.54 90.66 0 19.02 2.4 40.3 6.98 60.88-1.26-15.83-1.67-32.09-1.67-47.49 0-62.75 16.31-98.48 61.78-100.5Z" />
      <path fill="#a0c9e8" d="M278.53 73.33c-4.78-2.11-9.34-3.38-13.55-3.55-48.6-1.9-53.53 26.05-53.53 90.66 0 19.02 2.38 40.31 6.97 60.88-1.25-15.82-1.66-32.09-1.66-47.5 0-62.73 16.31-98.47 61.77-100.49Z" />
    </svg>
    {
      fotos.slice(0, 3).map((f, i) => (
        <div class={`m ${formatos[i].cls}`}>
          <Foto formatos={["avif"]} img={f} sizes={formatos[i].sizes} larguras={[240, 360, 480, 640]} proporcao={formatos[i].proporcao} />
        </div>
      ))
    }
  </div>

  <div class="texto">
    {sobretitulo && <p class="sobretitulo">{sobretitulo}</p>}
    <h2>
      {titulo}
      {tituloDestaque && <em>{tituloDestaque}</em>}
    </h2>
    <p class="lead">{texto}</p>
    {
      itens.length > 0 && (
        <ul class="icones">
          {itens.map((x) => (
            <li>
              <span class="bolha">
                <Icone nome={x.icone} tamanho={26} />
              </span>
              {x.rotulo}
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
