---
import type { Locale } from "../lib/types";
import type { Indice } from "../lib/routes";
import { t } from "../lib/i18n";
import { linkWhatsApp } from "../lib/config";
import RichText from "./RichText.astro";
import { homePath } from "../lib/routes";
import logoBranco from "../assets/marca/logo-horizontal-branco.svg";

interface Props {
  locale: Locale;
  indice: Indice;
}
const { locale, indice } = Astro.props;
const ui = t(locale);
const g = indice.conteudo.global[locale] ?? indice.conteudo.global.pt;
const paginas = [...indice.conteudo.institucionais, ...indice.conteudo.atendimento].filter((p) => p.locale === locale);
const linkPagina = (id: string) => indice.link("institucional", id, locale) ?? indice.link("atendimento", id, locale);
const ano = new Date().getFullYear();
const CREDITOS: Record<Locale, { direitos: string; dev: string }> = {
  pt: { direitos: "Todos os direitos reservados.", dev: "Desenvolvido por" },
  en: { direitos: "All rights reserved.", dev: "Developed by" },
  es: { direitos: "Todos los derechos reservados.", dev: "Desarrollado por" },
};
const cred = CREDITOS[locale];
const FRASE: Record<Locale, string> = {
  pt: "Cachoeira de 75 metros, day use e hospedagem na Serra do Itaqueri.",
  en: "A 75-metre waterfall, day pass and lodging in the Serra do Itaqueri.",
  es: "Cascada de 75 metros, pase de día y hospedaje en la Serra do Itaqueri.",
};
const NOMES_REDE: Record<string, string> = { instagram: "Instagram", facebook: "Facebook", youtube: "YouTube", tripadvisor: "Tripadvisor", tiktok: "TikTok" };
const nomeRede = (r: string) => NOMES_REDE[r.toLowerCase()] ?? r.charAt(0).toUpperCase() + r.slice(1);
/** Ícones das redes (24×24, cor do texto). Rede sem ícone usa o de link. */
const ICONE_REDE: Record<string, string> = {
  instagram: '<g fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/></g><circle cx="17.5" cy="6.5" r="1.3" fill="currentColor"/>',
  facebook: '<path fill="currentColor" d="M13.5 22v-8.2h2.8l.4-3.3h-3.2V8.4c0-.9.3-1.6 1.6-1.6h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.3v3.3h2.8V22Z"/>',
  youtube: '<path fill="currentColor" fill-rule="evenodd" d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.6 2.6 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.6 2.6 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8ZM10 15V9l5.2 3Z"/>',
  tripadvisor: '<g fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="7" cy="13.5" r="3.8"/><circle cx="17" cy="13.5" r="3.8"/><path d="M2.5 9.2C5 7.3 8.3 6.3 12 6.3s7 1 9.5 2.9"/></g><circle cx="7" cy="13.5" r="1.4" fill="currentColor"/><circle cx="17" cy="13.5" r="1.4" fill="currentColor"/>',
  tiktok: '<path fill="currentColor" d="M16.6 3h-3.2v12.2a2.7 2.7 0 1 1-2.7-2.7c.3 0 .5 0 .8.1V9.3a6 6 0 1 0 5.1 5.9V9.1a7.4 7.4 0 0 0 4.4 1.4V7.3a4.4 4.4 0 0 1-4.4-4.3Z"/>',
  link: '<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
};
const DIA: Record<Locale, Record<string, string>> = {
  pt: { Mo: "seg", Tu: "ter", We: "qua", Th: "qui", Fr: "sex", Sa: "sáb", Su: "dom" },
  en: { Mo: "Mon", Tu: "Tue", We: "Wed", Th: "Thu", Fr: "Fri", Sa: "Sat", Su: "Sun" },
  es: { Mo: "lun", Tu: "mar", We: "mié", Th: "jue", Fr: "vie", Sa: "sáb", Su: "dom" },
};
const dias = (s: string) => s.replace(/Mo|Tu|We|Th|Fr|Sa|Su/g, (d) => DIA[locale][d]).replace("-", " a ");
---

<footer class="rodape">
  <!-- Topo em onda (layout nov/2026): o fundo da página "cai" no poço, com uma faixa de água clara. -->
  <svg class="onda-topo" viewBox="0 0 1440 160" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path class="onda-clara" d="M0 0h1440v58c-170 46-360 70-560 46C640 76 420 18 220 30 130 36 60 54 0 74Z" />
    <path class="onda-branca" d="M0 0h1440v30c-190 44-390 60-600 34C620 38 420 0 230 8 140 12 64 28 0 46Z" />
  </svg>
  <!-- Fim da descida: os três arcos do logo, grandes e quase transparentes, no fundo do poço. -->
  <svg class="arcos-fundo" viewBox="166 62 118 166" aria-hidden="true" focusable="false">
    <path fill="#489ed2" d="M239.58 73.19c-4.78-2.11-9.34-3.38-13.55-3.55-48.59-1.9-53.53 26.05-53.53 90.66 0 19.02 2.39 40.3 6.97 60.88-1.26-15.83-1.66-32.09-1.66-47.49 0-62.75 16.3-98.48 61.77-100.5Z" />
    <path fill="#4076b6" d="M258.58 73.19c-4.79-2.11-9.34-3.38-13.55-3.55-48.61-1.9-53.54 26.05-53.54 90.66 0 19.02 2.4 40.3 6.98 60.88-1.26-15.83-1.67-32.09-1.67-47.49 0-62.75 16.31-98.48 61.78-100.5Z" />
    <path fill="#a0c9e8" d="M278.53 73.33c-4.78-2.11-9.34-3.38-13.55-3.55-48.6-1.9-53.53 26.05-53.53 90.66 0 19.02 2.38 40.31 6.97 60.88-1.25-15.82-1.66-32.09-1.66-47.5 0-62.73 16.31-98.47 61.77-100.49Z" />
  </svg>
  {
    g && (
      <div class="container rp-topo">
        <a class="rp-logo" href={homePath(locale)}>
          <img src={logoBranco.src} width="206" height="60" alt={`${g.nomeOficial} — ${ui.inicio}`} loading="lazy" decoding="async" />
        </a>
        <p class="rp-frase">{FRASE[locale]}</p>
        {g.redesSociais.length > 0 && (
          <ul class="rp-redes" aria-label={ui.seguirRedes}>
            {g.redesSociais.map((r) => (
              <li>
                <a href={r.url} rel="noopener me" target="_blank" aria-label={nomeRede(r.rede)} title={nomeRede(r.rede)}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" set:html={ICONE_REDE[r.rede.toLowerCase()] ?? ICONE_REDE.link} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
  {
    g && (
      <div class="container colunas">
        <section>
          <h2>{ui.contato}</h2>
          <address>
            {g.endereco.rua}, {g.endereco.numero}
            <br />
            {g.endereco.cidade} – {g.endereco.uf}, {g.endereco.cep}
            <br />
            <a href={`tel:${g.telefone.replace(/[^\d+]/g, "")}`} data-dl='{"event":"click_phone"}'>
              {g.telefone}
            </a>
            <br />
            <a href={`mailto:${g.email}`}>{g.email}</a>
          </address>
          <a class="btn btn-secundario whats" href={linkWhatsApp(g.whatsapp, g.whatsappMensagemPadrao)} rel="noopener" target="_blank" data-dl='{"event":"generate_lead","method":"whatsapp"}'>
            {ui.whatsapp}
          </a>
        </section>
        <section>
          <h2>{ui.horarios}</h2>
          <ul>
            {g.horarios.map((h) => (
              <li>
                {dias(h.dias)}: {h.abre}–{h.fecha}
              </li>
            ))}
          </ul>
        </section>
        <section class="rp-paginas">
          <h2>Saltão</h2>
          <ul>
            {paginas.map((p) => (
              <li>
                <a href={linkPagina(p.documentId)}>{p.titulo}</a>
              </li>
            ))}
            <li>
              <button type="button" class="link-cookies" data-cc="show-preferencesModal">
                {ui.preferenciasCookies}
              </button>
            </li>
          </ul>
        </section>
      </div>
    )
  }
  {g?.rodape && g.rodape.length > 0 && <div class="container extra"><RichText conteudo={g.rodape} /></div>}
  <div class="container copy">
    <p>© {ano} Saltão. {cred.direitos}</p>
    <p>{cred.dev} <a href="https://www.agenciabwm.com.br/" rel="noopener" target="_blank">Agência BWM</a></p>
  </div>
</footer>

<a class="whats-flutuante" href={g ? linkWhatsApp(g.whatsapp, g.whatsappMensagemPadrao) : "#"} rel="noopener" target="_blank" aria-label={ui.whatsapp} data-dl='{"event":"generate_lead","method":"whatsapp_flutuante"}'>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.7 5 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>
</a>

<style>
  .rodape {
    position: relative;
    overflow: hidden;
    margin-top: var(--space-9);
    background: var(--grad-poco);
    color: var(--color-on-deep);
    padding-block: calc(clamp(3rem, 9vw, 8rem) + var(--space-6)) var(--space-5);
    font-size: var(--fs-100);
  }
  .rodape > .onda-topo {
    position: absolute;
    inset: -1px 0 auto;
    width: 100%;
    height: clamp(3rem, 9vw, 8rem);
    pointer-events: none;
  }
  .onda-clara {
    fill: var(--brand-azul-claro);
    opacity: 0.55;
  }
  .onda-branca {
    fill: var(--color-bg);
  }
  .rodape > :not(.arcos-fundo):not(.onda-topo) {
    position: relative;
  }
  .arcos-fundo {
    position: absolute;
    right: -4%;
    bottom: -18%;
    width: clamp(14rem, 34vw, 30rem);
    height: auto;
    opacity: 0.14;
    pointer-events: none;
  }
  .rodape a,
  .link-cookies {
    color: #ffffff;
    text-decoration-color: rgb(160 201 232 / 0.6);
  }
  .rodape a:hover,
  .link-cookies:hover {
    color: var(--brand-azul-claro);
  }
  /* Faixa de cima: logo branco, frase e redes. Barras em azul mais escuro que o fundo separam as faixas. */
  .rp-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    padding-bottom: var(--space-6);
  }
  .rp-logo {
    display: block;
    flex: none;
  }
  .rp-logo img {
    display: block;
    width: clamp(10.5rem, 18vw, 13rem);
    height: auto;
  }
  .rp-frase {
    flex: 1 1 16rem;
    max-width: 30rem;
    margin: 0;
    color: var(--color-on-deep-muted);
  }
  .rp-redes {
    display: flex;
    gap: var(--space-3);
    margin: 0;
  }
  @media (min-width: 48rem) {
    .rp-redes {
      margin-left: auto;
    }
  }
  @media (max-width: 47.99rem) {
    .colunas > section + section {
      padding-top: var(--space-6);
      border-top: 3px solid var(--brand-abismo);
    }
  }
  .rp-redes li {
    margin: 0;
  }
  .rodape .rp-redes a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--brand-abismo);
    color: #ffffff;
    box-shadow: inset 0 0 0 1px rgb(160 201 232 / 0.18);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .rodape .rp-redes a:hover {
    background: var(--brand-azul);
    color: #ffffff;
    transform: translateY(-2px);
  }
  .rodape .rp-redes a:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 3px;
  }
  .rp-topo,
  .colunas {
    border-bottom: 3px solid var(--brand-abismo);
  }
  .colunas {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }
  .rp-paginas ul {
    columns: 2 11rem;
    column-gap: var(--space-6);
  }
  .rp-paginas li {
    break-inside: avoid;
  }
  @media (min-width: 48rem) {
    .colunas {
      grid-template-columns: 1.1fr 0.8fr 1.6fr;
      gap: 0;
    }
    /* Divisórias verticais entre as colunas, na mesma cor das barras. */
    .colunas > section {
      padding-inline: var(--space-6);
    }
    .colunas > section:first-child {
      padding-left: 0;
    }
    .colunas > section + section {
      border-left: 3px solid var(--brand-abismo);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rodape .rp-redes a {
      transition: none;
    }
  }
  h2 {
    font-size: var(--fs-300);
    font-weight: var(--fw-medio);
    color: #ffffff;
    margin: 0 0 var(--space-3);
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    margin-bottom: var(--space-2);
  }
  address {
    font-style: normal;
    margin-bottom: var(--space-4);
  }
  .whats {
    border-color: #ffffff;
    color: #ffffff;
  }
  .link-cookies {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
  .copy {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-top: var(--space-5);
    color: var(--color-on-deep-muted);
  }
  .copy p {
    margin: 0;
  }
  .copy a {
    color: var(--color-on-deep);
  }
  .copy a:hover {
    color: #ffffff;
  }
  .whats-flutuante {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1f7a45;
    color: #ffffff;
    box-shadow: 0 8px 22px -6px rgb(15 39 68 / 0.5);
  }
</style>
