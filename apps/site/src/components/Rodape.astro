---
import type { Locale } from "../lib/types";
import type { Indice } from "../lib/routes";
import { t } from "../lib/i18n";
import { linkWhatsApp } from "../lib/config";
import RichText from "./RichText.astro";
import Foto from "./Foto.astro";
import fotoQuedaSrc from "../assets/fotos/cachoeira-saltao/cachoeira-saltao-poco-vertical.jpg";
import fotoNoiteSrc from "../assets/fotos/camping/fogueira-noite-vertical.jpg";

interface Props {
  locale: Locale;
  indice: Indice;
}
const { locale, indice } = Astro.props;
const ui = t(locale);
const g = indice.conteudo.global[locale] ?? indice.conteudo.global.pt;
const paginas = [...indice.conteudo.institucionais, ...indice.conteudo.atendimento].filter((p) => p.locale === locale);
const linkPagina = (id: string) => indice.link("institucional", id, locale) ?? indice.link("atendimento", id, locale);
const ano = new Date().getFullYear();
const marca = (g?.nomeOficial ?? "Saltão").split(/\s+[—–-]\s+/)[0];
const seta = '<svg viewBox="0 0 56 12" width="44" height="12" aria-hidden="true"><path d="M0 6h54m-6-5 6 5-6 5" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>';
const ALT: Record<Locale, [string, string]> = {
  pt: ["Poço da Cachoeira do Saltão com a queda ao fundo", "Fogueira acesa à noite na área de camping"],
  en: ["Saltão waterfall pool with the drop behind", "Campfire at night in the camping area"],
  es: ["Poza de la cascada de Saltão con la caída al fondo", "Fogata encendida de noche en el camping"],
};
const DIA: Record<Locale, Record<string, string>> = {
  pt: { Mo: "seg", Tu: "ter", We: "qua", Th: "qui", Fr: "sex", Sa: "sáb", Su: "dom" },
  en: { Mo: "Mon", Tu: "Tue", We: "Wed", Th: "Thu", Fr: "Fri", Sa: "Sat", Su: "Sun" },
  es: { Mo: "lun", Tu: "mar", We: "mié", Th: "jue", Fr: "vie", Sa: "sáb", Su: "dom" },
};
const dias = (s: string) => s.replace(/Mo|Tu|We|Th|Fr|Sa|Su/g, (d) => DIA[locale][d]).replace("-", " a ");
---

<!--
  Rodapé em mosaico (mesma linha da home): foto | contato (poço) | visita e redes (azul Saltão) | páginas (azul claro) | foto.
  Cantos retos, blocos encostados, links com seta fina. Barra fina no pé com © e cookies.
-->
<footer class="rodape">
  {
    g && (
      <div class="rod-mosaico">
        <div class="rod-foto rod-foto--1">
          <Foto img={{ src: fotoQuedaSrc, alt: ALT[locale][0] }} sizes="(min-width: 64rem) 20vw, 50vw" larguras={[320, 480, 640]} class="rod-img" />
        </div>

        <section class="rod-bloco rod-bloco--poco">
          <p class="rod-marca" aria-hidden="true">{marca}</p>
          <h2 class="visually-hidden">{g.nomeOficial}</h2>
          <address>
            {g.endereco.rua}, {g.endereco.numero}
            <br />
            {g.endereco.cidade} – {g.endereco.uf}, {g.endereco.cep}
            <br />
            <a href={`tel:${g.telefone.replace(/[^\d+]/g, "")}`} data-dl='{"event":"click_phone"}'>
              {g.telefone}
            </a>
            <br />
            <a href={`mailto:${g.email}`}>{g.email}</a>
          </address>
          <a class="rod-link" href={linkWhatsApp(g.whatsapp, g.whatsappMensagemPadrao)} rel="noopener" target="_blank" data-dl='{"event":"generate_lead","method":"whatsapp"}'>
            <span>{ui.whatsapp}</span>
            <Fragment set:html={seta} />
          </a>
        </section>

        <section class="rod-bloco rod-bloco--azul">
          <h2>{ui.horarios}</h2>
          <ul class="rod-lista">
            {g.horarios.map((h) => (
              <li>
                {dias(h.dias)}: {h.abre}–{h.fecha}
              </li>
            ))}
          </ul>
          {g.redesSociais.length > 0 && (
            <>
              <h2>{ui.seguirRedes}</h2>
              <ul class="rod-lista rod-redes">
                {g.redesSociais.map((r) => (
                  <li>
                    <a href={r.url} rel="noopener me" target="_blank">
                      {r.rede.charAt(0).toUpperCase() + r.rede.slice(1)}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        <nav class="rod-bloco rod-bloco--claro" aria-label={marca}>
          <h2>{marca}</h2>
          <ul class="rod-lista rod-paginas">
            {paginas.map((p) => (
              <li>
                <a href={linkPagina(p.documentId)}>{p.titulo}</a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="rod-foto rod-foto--2">
          <Foto img={{ src: fotoNoiteSrc, alt: ALT[locale][1] }} sizes="(min-width: 64rem) 20vw, 50vw" larguras={[320, 480, 640]} class="rod-img" />
        </div>
      </div>
    )
  }
  <div class="rod-base">
    <p>© {ano} {g?.nomeOficial ?? "Saltão"}</p>
    {g?.rodape && g.rodape.length > 0 && <div class="rod-extra"><RichText conteudo={g.rodape} /></div>}
    <button type="button" class="link-cookies" data-cc="show-preferencesModal">{ui.preferenciasCookies}</button>
  </div>
</footer>

<a class="whats-flutuante" href={g ? linkWhatsApp(g.whatsapp, g.whatsappMensagemPadrao) : "#"} rel="noopener" target="_blank" aria-label={ui.whatsapp} data-dl='{"event":"generate_lead","method":"whatsapp_flutuante"}'>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6c-2 0-4-.6-5.7-1.6l-.4-.2-3.9 1 1-3.8-.3-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.4c.2.2 2.4 3.6 5.7 5 2.1.9 2.9 1 4 .8.6-.1 1.9-.8 2.2-1.5.3-.8.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4Z"/></svg>
</a>

<style>
  .rodape {
    background: var(--brand-poco);
    color: var(--color-on-deep);
    font-size: var(--fs-100);
  }
  .rod-mosaico {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .rod-foto {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--brand-poco);
  }
  .rod-foto > :global(picture) {
    display: block;
    height: 100%;
  }
  .rod-foto :global(.rod-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rod-foto--1 {
    grid-column: 1;
    grid-row: 1;
  }
  .rod-foto--2 {
    grid-column: 2;
    grid-row: 1;
  }
  .rod-bloco {
    grid-column: 1 / -1;
    padding: var(--space-7) clamp(var(--space-5), 6vw, var(--space-7));
  }
  .rod-bloco--poco {
    background: var(--brand-poco);
    color: var(--color-on-deep);
  }
  .rod-bloco--azul {
    background: var(--brand-azul);
    color: #ffffff;
  }
  .rod-bloco--claro {
    background: var(--brand-azul-claro);
    color: var(--brand-poco);
  }
  .rod-marca {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display-leve);
    font-size: clamp(2.5rem, 1.5rem + 3vw, 3.75rem);
    font-weight: 100;
    line-height: 0.9;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }
  .rodape h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-100);
    font-weight: var(--fw-forte);
    letter-spacing: 0.08em;
    color: inherit;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .rodape h2::before {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }
  .rod-lista + h2 {
    margin-top: var(--space-6);
  }
  address {
    font-style: normal;
    line-height: 1.8;
    margin-bottom: var(--space-5);
  }
  .rodape a {
    color: inherit;
    text-decoration: none;
  }
  .rodape a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .rod-lista {
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }
  .rod-lista a {
    display: inline-block;
    padding-block: var(--space-1);
  }
  .rod-redes {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
  }
  .rod-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    font-size: var(--fs-200);
    font-weight: var(--fw-medio);
    color: #ffffff;
  }
  .rod-link :global(svg) {
    transition: transform 0.35s ease;
  }
  .rodape .rod-link:hover {
    text-decoration: none;
  }
  .rod-link:hover :global(svg) {
    transform: translateX(8px);
  }
  .rod-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    width: min(100% - 2 * var(--space-4), var(--container));
    margin-inline: auto;
    padding-block: var(--space-5);
    color: var(--color-on-deep-muted);
  }
  .rod-base p {
    margin: 0;
  }
  .rod-extra :global(p) {
    margin: 0;
  }
  .link-cookies {
    padding: var(--space-2) 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .link-cookies:hover {
    color: #ffffff;
  }
  /* Computador: as cinco peças lado a lado, encostadas. */
  @media (min-width: 64rem) {
    .rod-mosaico {
      grid-template-columns: 1.1fr 1fr 1fr 1fr 1.1fr;
      min-height: clamp(22rem, 26vw, 28rem);
    }
    .rod-foto {
      aspect-ratio: auto;
    }
    .rod-foto--1 {
      grid-column: 1;
      grid-row: 1;
    }
    .rod-bloco {
      grid-column: auto;
      grid-row: 1;
      padding: clamp(var(--space-6), 3vw, var(--space-7));
    }
    .rod-foto--2 {
      grid-column: 5;
      grid-row: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rod-link :global(svg) {
      transition: none;
    }
  }
  .whats-flutuante {
    position: fixed;
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1f7a45;
    color: #ffffff;
    box-shadow: 0 8px 22px -6px rgb(15 39 68 / 0.5);
  }
</style>
