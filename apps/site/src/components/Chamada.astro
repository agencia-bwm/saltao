---
/** Chamada final da home: painel com foto de fundo, título e Reservar (+ WhatsApp). CSS em styles/home-abaixo.css. */
import type { Block, Cta, Locale } from "../lib/types";
import type { Indice } from "../lib/routes";
import { linkReserva, linkWhatsApp } from "../lib/config";
import Foto from "./Foto.astro";
import Icone from "./Icone.astro";

type Props = Extract<Block, { __component: "blocks.chamada" }> & { indice: Indice; locale: Locale };
const { sobretitulo, titulo, tituloDestaque, texto, imagem, cta, ctaSecundario, indice, locale } = Astro.props;
const g = indice.conteudo.global[locale] ?? indice.conteudo.global.pt;

function destino(c: Cta) {
  if (c.tipo === "whatsapp") return { href: g ? linkWhatsApp(g.whatsapp, g.whatsappMensagemPadrao) : "#", dl: '{"event":"generate_lead","method":"whatsapp_chamada"}', externo: true };
  if (c.tipo === "produto" && c.produtoId) return { href: indice.link("produto", c.produtoId, locale) ?? linkReserva({ lang: locale }), dl: '{"event":"click_reservar","method":"chamada"}', externo: false };
  return { href: c.url ?? linkReserva({ lang: locale }), dl: '{"event":"click_reservar","method":"chamada"}', externo: false };
}
const principal = destino(cta);
const secundario = ctaSecundario ? destino(ctaSecundario) : undefined;
---

<section class="chamada">
  <Foto formatos={["avif"]} img={imagem} sizes="(min-width: 92rem) 92rem, 100vw" larguras={[480, 800, 1200, 1600]} class="ch-foto" />
  <div class="ch-veu">
    <div class="ch-conteudo">
      {sobretitulo && <p class="sobretitulo">{sobretitulo}</p>}
      <h2>
        {titulo}
        {tituloDestaque && <span class="destaque">{tituloDestaque}</span>}
      </h2>
      {texto && <p class="ch-texto">{texto}</p>}
      <div class="ch-acoes">
        <a class="btn btn-claro" href={principal.href} data-dl={principal.dl}>
          <Icone nome="calendario" tamanho={20} />
          {cta.rotulo}
          <Icone nome="seta" tamanho={18} class="seta" />
        </a>
        {
          secundario && ctaSecundario && (
            <a class="btn ch-secundario" href={secundario.href} data-dl={secundario.dl} rel={secundario.externo ? "noopener" : undefined} target={secundario.externo ? "_blank" : undefined}>
              {ctaSecundario.rotulo}
            </a>
          )
        }
      </div>
    </div>
  </div>
  <svg class="ch-arcos" viewBox="166 62 118 166" aria-hidden="true" focusable="false">
    <path d="M239.58 73.19c-4.78-2.11-9.34-3.38-13.55-3.55-48.59-1.9-53.53 26.05-53.53 90.66 0 19.02 2.39 40.3 6.97 60.88-1.26-15.83-1.66-32.09-1.66-47.49 0-62.75 16.3-98.48 61.77-100.5Z" />
    <path d="M258.58 73.19c-4.79-2.11-9.34-3.38-13.55-3.55-48.61-1.9-53.54 26.05-53.54 90.66 0 19.02 2.4 40.3 6.98 60.88-1.26-15.83-1.67-32.09-1.67-47.49 0-62.75 16.31-98.48 61.78-100.5Z" />
    <path d="M278.53 73.33c-4.78-2.11-9.34-3.38-13.55-3.55-48.6-1.9-53.53 26.05-53.53 90.66 0 19.02 2.38 40.31 6.97 60.88-1.25-15.82-1.66-32.09-1.66-47.5 0-62.73 16.31-98.47 61.77-100.49Z" />
  </svg>
</section>
